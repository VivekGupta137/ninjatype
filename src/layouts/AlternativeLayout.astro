---
import BaseLayout from './BaseLayout.astro';
import GuideCountdown from '@/components/common/GuideCountdown.astro';
import { getOrganizationSchema, getWebsiteSchema, getWebPageSchema, getFAQPageSchema } from '@/lib/schema-templates';
import '../styles/alternatives.css';
interface Props {
    title: string; description: string; competitor?: string; variant: string; pageLabel?: string;
    action: string; href: string; faqs: { question: string; answer: string }[];
}
const { title, description, competitor, variant, action, href, faqs, pageLabel } = Astro.props;
const destinationLabel = ({
    '/': 'typing practice',
    '/learn/': 'touch typing lessons',
    '/multiplayer-typing-race/': 'multiplayer typing race',
    '/ghost-race/': 'Ghost Race',
    '/hacker-typer/': 'Hacker Typer',
} as Record<string, string>)[href] || 'NinjaType';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = `/images/alternatives/${variant}.png`;
const schema = { '@context': 'https://schema.org', '@graph': [
    getOrganizationSchema(), getWebsiteSchema(), getWebPageSchema({ url: canonical, name: title, description }), getFAQPageSchema(faqs),
    { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'NinjaType', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: pageLabel || `${competitor} alternative`, item: canonical },
    ] },
] };
---
<BaseLayout title={title} description={description} canonical={canonical} image={image} imageAlt={`${pageLabel || `${competitor} alternative`} — NinjaType`} includeApplicationSchema={false}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <div class:list={['lp-page', `lp-${variant}`]}>
        <GuideCountdown href={href} label={destinationLabel} />
        <header class="lp-header lp-wrap">
            <a class="lp-brand bagel-fat-one-regular" href="/" aria-label="NinjaType home">Ninja Type<span aria-hidden="true">↗</span></a>
            <nav aria-label="Explore NinjaType"><a href="/lp/">Compare sites</a><a class="lp-nav-action" href={href}>{action}<span aria-hidden="true">↗</span></a></nav>
        </header>
        <main id="main-content"><slot /></main>
        <footer class="lp-footer lp-wrap">
            <div><a class="lp-brand bagel-fat-one-regular" href="/">Ninja Type</a><p>A little more fun at your fingertips.</p></div>
            <nav aria-label="Explore more"><a href="/lp/">All typing alternatives</a><a href="/learn/">Touch typing lessons</a><a href="/multiplayer-typing-race/">Race with friends</a></nav>
            <div class="lp-fine-print"><p>{competitor ? `NinjaType is independent and is not affiliated with or endorsed by ${competitor}.` : "NinjaType is independent of the other services listed here."} Other product names belong to their respective owners.</p><a href="/privacy-policy/">Privacy</a><a href="/terms-of-service/">Terms</a></div>
        </footer>
    </div>
</BaseLayout>
