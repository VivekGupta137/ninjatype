---
import SEO from "@/components/seo/SEO.astro";
import CommonSettings from "@/components/CommonSettings.astro";
import "@/styles/global.css";
import "@/styles/content.css";
import CommonHead from "@/components/common/CommonHead.astro";
import { ViewTransitions } from "astro:transitions";

export interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    image?: string;
    imageAlt?: string;
    type?: "website" | "article";
    author?: string;
    publishDate?: string;
    noindex?: boolean;
    nofollow?: boolean;
}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <CommonHead />
        <!-- SEO Component -->
        <SEO {...seoProps} />

        <!-- View Transitions for smooth page navigation -->
        <ViewTransitions />

        <!-- Google Tag Manager -->
        <script type="text/partytown">
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-THG488VG');
        </script>
        <!-- End Google Tag Manager -->
        <!-- Simple analytics with Partytown -->
        <script
            type="text/partytown"
            data-collect-dnt="true"
            src="https://scripts.simpleanalyticscdn.com/latest.js"></script>

        <!-- Common Settings -->
        <CommonSettings />

        <!-- Iconify Icon Web Component -->
        <script>
            import "iconify-icon";
        </script>
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-THG488VG"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        <!-- Skip to main content link for accessibility -->
        <a href="#main-content" class="skip-link"> Skip to main content </a>
        <slot />
    </body>
</html>

<style is:global>
    .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #000;
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        z-index: 10000;
        border-radius: 4px;
        font-weight: 600;
    }

    .skip-link:focus {
        top: 8px;
        left: 8px;
        outline: 2px solid #3b82f6;
        outline-offset: 2px;
    }
</style>
