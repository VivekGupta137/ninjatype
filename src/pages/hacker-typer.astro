---
import "../styles/hacker.css";
import HackerLayout from "@/components/hacker/HackerLayout";
import HackerHelp from "@/components/hacker/HackerHelp.astro";
import { ViewTransitions } from "astro:transitions";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";
import {
    getOrganizationSchema,
    getWebsiteSchema,
    getHackerTyperAppSchema,
    getWebPageSchema,
    getFAQPageSchema,
    createSchemaGraph,
} from "@/lib/schema-templates";

const isDev = import.meta.env.DEV;

const canonicalURL = new URL(
    "/hacker-typer/",
    Astro.site || Astro.url.origin
).href;

const title = "Hacker Typer: Free Fake Hacking & Prank Screen | NinjaType";
const description =
    "Create a fake hacking screen with free Hacker Typer. Type to reveal code, choose a terminal theme, and stage a hacking prank or fictional scene in your browser.";

const keywords =
    "hacker typer, hackertyper, fake hacker screen, geek typer, geektyper, hollywood hacker, cyber terminal simulator, matrix code simulator, fake coding screen, hacker prank, code typing simulator, terminal typing game, access granted screen";

const faqs = [
    {
        question: "What is Hacker Typer?",
        answer: "NinjaType Hacker Typer is a free browser simulator that turns keyboard interaction into a movie-style code display. Its process, network, memory and payload panels are simulated visual effects for fake hacking scenes, not a real intrusion or a typing-speed test.",
    },
    {
        question: "How do you trigger payload injection and the Access Granted screen?",
        answer: "Press Enter or Run in the payload panel to begin the simulated sequence. Its staged analysis and transfer steps end with your configured Access Granted or Access Denied message. Follow NinjaType's visible controls; shortcuts from other Hacker Typer sites can differ.",
    },
    {
        question: "Is Hacker Typer safe and free to use?",
        answer: "Yes. Hacker Typer is 100% free and completely harmless. It runs entirely in your web browser with client-side simulation. It does not perform any real network attacks, execute exploits, or install software.",
    },
    {
        question: "What themes and layout customization options are available?",
        answer: "NinjaType Hacker Typer supports Hacker Green (CRT), Amber CRT, Cyber Cyan, and AMOLED themes. You can also hide or show individual tmux panes including the Code Editor, Process Monitor, Network Topology Radar, Memory Dump, and Disassembly View.",
    },
    {
        question: "Can I use Hacker Typer for video production, movies, and pranks?",
        answer: "You can use it as a fictional terminal scene or a playful hacking prank. Choose a theme and visible panels, then use Fullscreen in a supported browser. The display is simulated, and its generated code does not measure your real typing speed.",
    },
    {
        question: "Is NinjaType Hacker Typer the same as Geek Typer?",
        answer: "No. Geek Typer, also written GeekTyper, and HackerTyper.net are separate sites. NinjaType offers its own multi-panel Hacker Typer with terminal themes and staged result messages. The comparison guide explains the differences; NinjaType is not affiliated with those services.",
    },
    {
        question: "Can fake hacking help me learn touch typing?",
        answer: "The simulator generates a code display from keypresses, so it does not grade the text you typed. To train real keyboard skill, use NinjaType's free touch typing lessons and passage tests, then compare your WPM and accuracy over similar sessions.",
    },
];

const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getHackerTyperAppSchema(),
    getWebPageSchema({
        url: canonicalURL,
        name: title,
        description,
        dateModified: new Date().toISOString(),
    }),
    getFAQPageSchema(faqs)
);

const breadcrumbs = [
    { name: "Home", url: "https://www.ninjatype.com/" },
    { name: "Hacker Typer", url: canonicalURL },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
        <title>{title}</title>

        <!-- Primary SEO Meta Tags -->
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <link rel="canonical" href={canonicalURL} />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta
            name="googlebot"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />

        <!-- Favicons & App Icons -->
        <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon/favicon-180x180.png" />
        <link rel="icon" sizes="32x32" href="/favicon/favicon-32x32.png" />
        <link rel="icon" sizes="16x16" href="/favicon/favicon-16x16.png" />
        <link rel="manifest" href="/favicon/manifest.json" />
        <meta name="theme-color" content="#000000" />
        <meta name="color-scheme" content="dark" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://www.ninjatype.com/images/og-image.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="NinjaType Hacker Typer Terminal Simulator" />
        <meta property="og:site_name" content="NinjaType" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://www.ninjatype.com/images/og-image.png" />
        <meta name="twitter:creator" content="@realninjatype" />

        <!-- View Transitions -->
        <ViewTransitions />

        <!-- Partytown Analytics: Offloaded to Web Worker in Production -->
        {!isDev && (
            <>
                <script type="text/partytown">
                    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                    })(window,document,'script','dataLayer','GTM-THG488VG');
                </script>
                <script
                    type="text/partytown"
                    data-collect-dnt="true"
                    src="https://scripts.simpleanalyticscdn.com/latest.js"
                />
            </>
        )}

        <!-- Structured Data JSON-LD Graph (WebApplication, WebPage, FAQPage, Organization) -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaMarkup)}
        />

        <!-- Breadcrumb Schema -->
        <BreadcrumbSchema items={breadcrumbs} />

        {isDev && (
            <script is:inline type="module">
                import RefreshRuntime from "/@react-refresh";
                RefreshRuntime.injectIntoGlobalHook(window);
                window.$RefreshReg$ = () => {};
                window.$RefreshSig$ = () => (type) => type;
                window.__vite_plugin_react_preamble_installed__ = true;
            </script>
        )}

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            html, body {
                width: 100%;
                height: 100%;
                overflow: hidden;
                background: #000;
                color: #00ff41;
                font-family: "Courier New", "Lucida Console", "Consolas", monospace;
            }
        </style>
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-THG488VG"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
            ></iframe>
        </noscript>

        <!-- Interactive Terminal Simulator -->
        <HackerLayout client:load />

        <HackerHelp faqs={faqs} />
    </body>
</html>
