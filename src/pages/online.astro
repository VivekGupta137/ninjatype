---
import Footer from "@/components/Footer";
import Header from "@/components/Header.astro";
import OnlineKeyboardContainer from "@/components/online/OnlineKeyboardContainer";
import FAQ from "@/components/seo/FAQ";
import "../styles/online.css";
import { onlinePageFAQs } from "@/constants/faq";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
    createSchemaGraph,
    getFAQPageSchema,
    getWebPageSchema,
} from "@/lib/schema-templates";

const canonicalURL = new URL("/online", Astro.site || Astro.url.origin).href;
const schemaMarkup = createSchemaGraph(
    getWebPageSchema({
        url: canonicalURL,
        name: "NinjaType Online Typing Race",
        description:
            "Race against the recorded pace of your past typing attempts, with standings, accurate timing, WPM tracking, and accuracy insights. Choose a 15, 30, or 50-word track.",
    }),
    getFAQPageSchema(onlinePageFAQs),
);
---

<BaseLayout
    title="Typing Race - Beat Your Past Attempts | NinjaType"
    description="Race against your past attempts in NinjaType's minimalist typing race. Choose a 15, 30, or 50-word track, follow standings, and improve your speed and accuracy."
    canonical={canonicalURL}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(schemaMarkup)}
    />

    <div id="body-container">
        <Header />

        <main id="main-content">
            <OnlineKeyboardContainer client:load />
            <FAQ faqs={onlinePageFAQs} client:load />
        </main>
        <Footer />
    </div>
</BaseLayout>
