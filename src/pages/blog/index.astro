---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { getBlogPosts } from '@/lib/blog';
import { GUIDE_APPS, type GuideApp } from '@/lib/guideApps';
import '../../styles/blog.css';

const posts = await getBlogPosts();
const featured = posts.find(post => post.featured) ?? posts[0];
const groups = (Object.keys(GUIDE_APPS) as GuideApp[]).map(key => ({ key, ...GUIDE_APPS[key], posts: posts.filter(post => post.app === key && post.url !== featured?.url) }));
const title = 'NinjaType Blog — Typing Practice, Multiplayer Races & Guides';
const description = 'Learn how to type faster with NinjaType guides to typing tests, accuracy, touch typing, multiplayer games, Ghost Race and Hacker Typer.';
const canonical = new URL('/blog/', Astro.site || Astro.url.origin).href;
const dateLabel = (date: string) => new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const schema = {
    '@context': 'https://schema.org', '@type': 'Blog', '@id': `${canonical}#blog`, name: 'NinjaType Blog', url: canonical,
    description, inLanguage: 'en', publisher: { '@type': 'Organization', name: 'NinjaType', url: 'https://www.ninjatype.com/' },
    blogPost: posts.map(post => ({ '@type': 'BlogPosting', headline: post.title, url: new URL(post.url, canonical).href,
        datePublished: post.publishDate, description: post.description })),
};
---
<BaseLayout title={title} description={description} canonical={canonical} includeApplicationSchema={false}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <BreadcrumbSchema items={[{ name: 'Home', url: 'https://www.ninjatype.com/' }, { name: 'Blog', url: canonical }]} />
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="blog-shell">
            <header class="blog-heading">
                <span class="blog-eyebrow">THE NINJATYPE BLOG</span>
                <h1>Typing guides.<br />Practice with a purpose.</h1>
                <p>Find a training method for your next step: a steadier pace, fewer mistakes, or a friendly race.</p>
                <div class="blog-actions"><a class="blog-key-link" href="/multiplayer-typing-race/">Start a typing race <span aria-hidden="true">↗</span></a><a href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a></div>
            </header>
            <nav class="blog-topic-nav" aria-label="Guides by app">{groups.map(group => <a class="blog-key-link" href={`#${group.key}`}>{group.label}</a>)}</nav>
            {featured && <section class="blog-featured" aria-labelledby="featured-title">
                <div class="blog-meta"><span>{featured.category}</span><span>{featured.readTime}</span></div>
                <span class="blog-eyebrow">FEATURED GUIDE</span>
                <h2 id="featured-title"><a href={featured.url}>{featured.title}</a></h2>
                <p>{featured.description}</p>
                <div class="blog-card-footer"><time datetime={featured.publishDate}>{dateLabel(featured.publishDate)}</time><a class="blog-key-link" href={featured.url}>Read the guide <span aria-hidden="true">→</span></a></div>
            </section>}
            {groups.filter(group => group.posts.length > 0).map(group => <section id={group.key} class="blog-posts blog-topic-section" aria-labelledby={`${group.key}-title`}>
                <div class="blog-section-heading"><div><h2 id={`${group.key}-title`}>{group.label}</h2><p>{group.description}</p></div><a href={group.href}>Open the app →</a></div>
                <div class="blog-grid">{group.posts.map(post => <article class="blog-card">
                    <div class="blog-meta"><span>{post.category}</span><span>{post.readTime}</span></div>
                    <h3><a href={post.url}>{post.title}</a></h3><p>{post.description}</p>
                    <div class="blog-card-footer"><time datetime={post.publishDate}>{dateLabel(post.publishDate)}</time><a href={post.url} aria-label={`Read ${post.title}`}>Read guide <span aria-hidden="true">→</span></a></div>
                </article>)}</div>
            </section>)}
            <aside class="blog-practice-note"><p>Put a guide into practice.</p><div><a href="/">Solo typing test →</a><a href="/learn/">Learn touch typing →</a><a href="/multiplayer-typing-race/">Race with friends →</a></div></aside>
        </main>
        <Footer />
    </div>
</BaseLayout>
