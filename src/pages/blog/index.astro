---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { getBlogPosts } from '@/lib/blog';
import { GUIDE_APPS, type GuideApp } from '@/lib/guideApps';
import KeyLink from '@/components/ui/KeyLink';
import TextLink from '@/components/ui/TextLink';
import { Card, Chip } from '@heroui/react';
import '../../styles/blog.css';
import '../../styles/blog-index.css';

const posts = await getBlogPosts();
const featured = posts.find(post => post.featured) ?? posts[0];
const groups = (Object.keys(GUIDE_APPS) as GuideApp[]).map(key => ({ key, ...GUIDE_APPS[key], posts: posts.filter(post => post.app === key && post.url !== featured?.url) }));
const title = 'NinjaType Blog — Typing Practice, Multiplayer Races & Guides';
const description = 'Learn how to type faster with NinjaType guides to typing tests, accuracy, touch typing, multiplayer games, Ghost Race and Hacker Typer.';
const canonical = new URL('/blog/', Astro.site || Astro.url.origin).href;
const dateLabel = (date: string) => new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const schema = {
    '@context': 'https://schema.org', '@type': 'Blog', '@id': `${canonical}#blog`, name: 'NinjaType Blog', url: canonical,
    description, inLanguage: 'en', publisher: { '@type': 'Organization', name: 'NinjaType', url: 'https://www.ninjatype.com/' },
    blogPost: posts.map(post => ({ '@type': 'BlogPosting', headline: post.title, url: new URL(post.url, canonical).href,
        datePublished: post.publishDate, description: post.description })),
};
---
<BaseLayout title={title} description={description} canonical={canonical} includeApplicationSchema={false}
    alternates={[
        { lang: 'en', href: canonical },
        { lang: 'de', href: 'https://www.ninjatype.com/de/blog/' },
        { lang: 'fr', href: 'https://www.ninjatype.com/fr/blog/' },
        { lang: 'ja', href: 'https://www.ninjatype.com/ja/blog/' },
        { lang: 'nl', href: 'https://www.ninjatype.com/nl/blog/' },
        { lang: 'it', href: 'https://www.ninjatype.com/it/blog/' },
        { lang: 'sv', href: 'https://www.ninjatype.com/sv/blog/' },
        { lang: 'da', href: 'https://www.ninjatype.com/da/blog/' },
        { lang: 'no', href: 'https://www.ninjatype.com/no/blog/' },
    ]}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <BreadcrumbSchema items={[{ name: 'Home', url: 'https://www.ninjatype.com/' }, { name: 'Blog', url: canonical }]} />
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="blog-shell blog-index">
            <header class="bi-hero">
                <Chip size="sm" variant="soft"><Chip.Label>The NinjaType blog</Chip.Label></Chip>
                <h1>Typing guides. Practice with a purpose.</h1>
                <p class="bi-lede">Find a training method for your next step: a steadier pace, fewer mistakes, or a friendly race.</p>
                <div class="bi-actions"><KeyLink variant="primary" href="/multiplayer-typing-race/">Start a typing race<span aria-hidden="true">↗</span></KeyLink><KeyLink href="/stories/">Watch Web Stories<span aria-hidden="true">↗</span></KeyLink><KeyLink variant="ghost" href="/rss.xml">Follow via RSS<span aria-hidden="true">↗</span></KeyLink></div>
                <nav class="bi-toc" aria-label="Guides by app">{groups.filter(group => group.posts.length > 0).map(group => <KeyLink size="sm" href={`#${group.key}`}>{group.label}</KeyLink>)}</nav>
            </header>
            {featured && <Card className="bi-featured" aria-labelledby="featured-title">
                <div class="bi-meta"><Chip size="sm" variant="soft" color="accent"><Chip.Label>Featured guide</Chip.Label></Chip><Chip size="sm" variant="soft"><Chip.Label>{featured.category}</Chip.Label></Chip><Chip size="sm" variant="soft"><Chip.Label>{featured.readTime}</Chip.Label></Chip></div>
                <h2 id="featured-title"><a href={featured.url}>{featured.title}</a></h2>
                <p>{featured.description}</p>
                <div class="bi-footer"><time datetime={featured.publishDate}>{dateLabel(featured.publishDate)}</time><KeyLink variant="primary" href={featured.url}>Read the guide<span aria-hidden="true">→</span></KeyLink></div>
            </Card>}
            {groups.filter(group => group.posts.length > 0).map(group => <section id={group.key} class="bi-section" aria-labelledby={`${group.key}-title`}>
                <header class="bi-section-head"><div><h2 id={`${group.key}-title`}>{group.label}</h2><p>{group.description}</p></div><TextLink variant="muted" size="sm" href={group.href}>Open the app →</TextLink></header>
                <div class="bi-grid">{group.posts.map(post => <Card className="bi-card">
                    <div class="bi-meta"><Chip size="sm" variant="soft"><Chip.Label>{post.category}</Chip.Label></Chip><Chip size="sm" variant="soft"><Chip.Label>{post.readTime}</Chip.Label></Chip></div>
                    <h3><a href={post.url}>{post.title}</a></h3><p>{post.description}</p>
                    <div class="bi-footer"><time datetime={post.publishDate}>{dateLabel(post.publishDate)}</time><KeyLink variant="ghost" size="sm" href={post.url} aria-label={`Read ${post.title}`}>Read guide<span aria-hidden="true">→</span></KeyLink></div>
                </Card>)}</div>
            </section>)}
            <aside class="bi-practice" aria-labelledby="practice-title"><h2 id="practice-title">Put a guide into practice</h2><div class="bi-actions"><KeyLink variant="primary" href="/">Solo typing test<span aria-hidden="true">→</span></KeyLink><KeyLink href="/learn/">Learn touch typing<span aria-hidden="true">→</span></KeyLink><KeyLink href="/multiplayer-typing-race/">Race with friends<span aria-hidden="true">→</span></KeyLink></div></aside>
        </main>
        <Footer />
    </div>
</BaseLayout>
