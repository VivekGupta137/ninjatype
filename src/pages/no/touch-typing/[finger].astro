---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from "@/lib/schema-templates";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import { FINGER_NAMES_NO } from "@/constants/fingerKeysNO";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/no/touch-typing/");
}

const fingerType = finger as FingerType;

const canonicalURL = new URL(`/no/touch-typing/${finger}/`, Astro.site || Astro.url.origin).href;
const pageTitle = `${FINGER_NAMES_NO[fingerType]}-trening: Touch typing-øvelser | NinjaType`;
const pageDescription = `Lær touch typing med ${FINGER_NAMES_NO[fingerType]}: QWERTY-leksjoner for det norske 10-fingersystemet — grunnstilling, øvre og nedre griper, med framgang per nivå.`;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: pageTitle, description: pageDescription, inLanguage: "no" }),
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalURL}
    lang="no"
    ogLocale="nb_NO"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "no", href: canonicalURL },
    ]}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <div id="body-container">
        <Header locale="no" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="no" client:load />
            </div>
        </main>

        <Footer locale="no" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
