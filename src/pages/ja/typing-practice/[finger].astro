---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from "@/lib/schema-templates";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import { FINGER_NAMES_JA } from "@/constants/fingerKeysJA";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/ja/typing-practice/");
}

const fingerType = finger as FingerType;

const canonicalURL = new URL(`/ja/typing-practice/${finger}/`, Astro.site || Astro.url.origin).href;
const pageTitle = `${FINGER_NAMES_JA[fingerType]}トレーニング：ローマ字タイピングレッスン | NinjaType`;
const pageDescription = `タイピング練習：${FINGER_NAMES_JA[fingerType]}のレッスンで正確な入力を習得。ホームポジションから上段・下段へ段階的に進める実践的なレッスン。QWERTY ローマ字入力対応、進捗ローカル保存、無料・登録不要。正確さを優先し、速さは後から伸ばします。`;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: pageTitle, description: pageDescription, inLanguage: "ja" }),
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalURL}
    lang="ja"
    ogLocale="ja_JP"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "ja", href: canonicalURL },
    ]}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <div id="body-container">
        <Header locale="ja" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="ja" client:load />
            </div>
        </main>

        <Footer locale="ja" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
