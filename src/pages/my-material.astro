---
import Footer from "@/components/Footer";
import Header from "@/components/Header.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MaterialApp from "@/components/material/MyMaterial";
import "../styles/analytics.css";

const title = "Type Your Own Text: Custom Typing Practice | NinjaType";
const description =
    "Paste your own text to practise typing, such as medical notes or legal clauses. Your material stays private in this browser and never leaves your device.";
const canonicalURL = new URL("/my-material/", Astro.site || Astro.url.origin).href;
---

<BaseLayout title={title} description={description} canonical={canonicalURL} noindex>
    <div id="body-container" class="analytics-page">
        <Header />
        <main id="main-content">
            <MaterialApp client:only="react" />
        </main>
        <Footer />
    </div>
</BaseLayout>
