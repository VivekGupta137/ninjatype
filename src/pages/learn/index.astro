---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import FingerSelection from "@/components/learn/FingerSelection";
import PageFAQ from "@/components/seo/PageFAQ.astro";
import PracticeGuide from "@/components/seo/PracticeGuide.astro";
import TrainingGuides from "@/components/blog/TrainingGuides.astro";
import { learnPageFAQs } from "@/constants/faq";
import "../../styles/learn.css";
import {
    getOrganizationSchema,
    getWebsiteSchema,
    getWebApplicationSchema,
    getWebPageSchema,
    getFAQPageSchema,
    createSchemaGraph,
} from "@/lib/schema-templates";

const title = 'Free Touch Typing Lessons for Beginners | NinjaType';
const description = 'Learn touch typing with free finger exercises and a QWERTY key guide. Practise home row placement, track accuracy, and build your typing skills at your pace.';
const canonicalURL = new URL("/learn/", Astro.site || Astro.url.origin).href;

const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: title, description }),
    getWebApplicationSchema({ url: canonicalURL, name: title, description, features: ['Four paired-finger lessons', 'QWERTY finger placement guide', 'Local lesson progress and stars'] }),
    getFAQPageSchema(learnPageFAQs),
);
---

<BaseLayout
    title={title}
    description={description}
    canonical={canonicalURL} includeApplicationSchema={false}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(schemaMarkup)}
    />

    <div id="body-container">
        <Header />

        <main id="main-content">
            <div id="learn-main-container">
                <FingerSelection client:load />
            </div>
            <PracticeGuide title="Touch typing for beginners: where to start">
                <h2>Practise home row finger placement</h2>
                <p>Rest your left fingers on A, S, D, F and your right fingers on J, K, L, semicolon. Use the bumps on F and J to find your starting position by feel. Choose a finger lesson above and follow the QWERTY key guide at a comfortable pace.</p>
                <h2>Apply your lessons to everyday words</h2>
                <p>Review your lesson accuracy and repeat difficult keys before increasing speed. Then try a <a href="/">free typing test</a> to bring the finger exercises together. For a personal pace challenge, use <a href="/ghost-race/">Ghost Race</a>; for a shared practice round, try a <a href="/multiplayer-typing-race/">multiplayer typing game</a>.</p>
                <PageFAQ slot="faq" title="Touch typing lessons FAQ" faqs={learnPageFAQs} />
            </PracticeGuide>
            <TrainingGuides app="learn" />
        </main>

        <Footer />
    </div>
</BaseLayout>

<style>
    #learn-main-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0;
        min-height: 60vh;
    }
</style>
