---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/learn");
}

const fingerType = finger as FingerType;
const fingerNames = {
    pointer: "Index Finger",
    middle: "Middle Finger",
    ring: "Ring Finger",
    pinky: "Pinky Finger"
};

const canonicalURL = new URL(`/learn/fingers/${finger}/`, Astro.site || Astro.url.origin).href;

/** Localised finger-lesson hubs; each locale's finger page is the counterpart of this English page. */
const LOCALE_FINGER_HUBS: { lang: string; hub: string }[] = [
    { lang: "de", hub: "/de/tippen-lernen/" },
    { lang: "fr", hub: "/fr/apprendre-a-taper-au-clavier/" },
    { lang: "ja", hub: "/ja/typing-practice/" },
    { lang: "nl", hub: "/nl/blind-typen/" },
    { lang: "it", hub: "/it/dattilografia/" },
    { lang: "sv", hub: "/sv/tangentbordstraning/" },
    { lang: "da", hub: "/da/maskinskrivning/" },
    { lang: "no", hub: "/no/touch-typing/" },
];
const fingerAlternates = [
    { lang: "en", href: canonicalURL },
    ...LOCALE_FINGER_HUBS.map(({ lang, hub }) => ({ lang, href: `https://www.ninjatype.com${hub}${finger}/` })),
];
---

<BaseLayout
    title={`${fingerNames[fingerType]} Practice - NinjaType`}
    description={`Practice touch typing with your ${fingerNames[fingerType].toLowerCase()}. Build muscle memory, improve accuracy and raise your typing speed with free lessons.`}
    canonical={canonicalURL}
    alternates={fingerAlternates}
>
    <div id="body-container">
        <Header />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} client:load />
            </div>
        </main>

        <Footer />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
