---
import AlternativeLayout from '@/layouts/AlternativeLayout.astro';
import AlternativeFAQ from '@/components/seo/AlternativeFAQ.astro';
import { alternativePages, alternativeGroups } from '@/data/alternatives';
const faqs = [
    { question:'Which NinjaType activity should I start with?', answer:'Start with a solo typing test for a WPM baseline, Learn for QWERTY finger placement, Ghost Race for a solo pace challenge, or multiplayer rooms to race friends. Hacker Typer is a visual simulator and does not measure typing speed.' },
    { question:'Why make NinjaType my main typing site?', answer:'Use one familiar place for tests, finger lessons and races. NinjaType adds local history, a forgiving daily streak and shareable results, so you can move from measuring your pace to practising a movement or inviting friends without starting a new routine elsewhere.' },
    { question:'Can I bring another site’s history to NinjaType?', answer:'NinjaType does not import competitor accounts, rankings or history. Start a new practice record here. Your attempts, settings and lesson progress are saved locally in this browser.' },
    { question:'Is NinjaType free to make part of my daily routine?', answer:'Yes. Tests, finger lessons, Ghost Race, multiplayer races and the terminal simulator are free. No typing account is required. Multiplayer uses a nickname and security check before you enter a room.' },
];
---
<AlternativeLayout title="Typing Website Alternatives: Find Your Daily Practice | NinjaType" description="Compare typing websites and find your daily practice on NinjaType. Explore alternatives to Monkeytype, TypingClub, TypeRacer, Keybr and more, with free tests and games." variant="directory" pageLabel="Typing website alternatives" action="Start typing" href="/" faqs={faqs}>
<section class="directory-hero lp-wrap"><span class="lp-kicker">Find your next daily typing home</span><h1>More ways to type.<br /><em>One place to return to.</em></h1><p class="lp-lede">Bring the part you love about typing. Find a little more of it on NinjaType: a calm test, a focused lesson, a friendly race, or a fictional terminal just for fun.</p><div class="lp-actions"><a class="lp-primary" href="/">Try NinjaType free ↗</a><a class="lp-text-link" href="/learn/">Start with touch typing</a></div><nav class="directory-jumps" aria-label="Browse comparison categories">{alternativeGroups.map((group,i)=><a href={`#category-${i}`}>{group} <span aria-hidden="true">↓</span></a>)}</nav></section>
{alternativeGroups.map((group,i)=><section class="directory-group lp-wrap" id={`category-${i}`}><div class="directory-heading"><span class="lp-kicker">0{i+1} / FIND YOUR WAY IN</span><h2>{group}</h2></div><div class="directory-cards">{alternativePages.filter(page=>page.group===group).map(page=><a href={`/lp/${page.slug}/`}><img src={`/images/alternatives/${page.variant}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async"/><div><h3>{page.name}{page.slug==='typing-speed-test'?'':' alternative'}<span aria-hidden="true">↗</span></h3><p>{page.summary}</p></div></a>)}</div></section>)}
<section class="directory-promise lp-wrap"><span class="lp-kicker">Give your practice a familiar home</span><h2>Free to start.<br /><em>Plenty to come back for.</em></h2><p>Keep local history. Build a forgiving streak. Share an attempt you’re proud of. Make the next round a little more social, or slow down for a finger lesson. The useful part is the routine you build.</p><a class="lp-primary" href="/">Start your NinjaType routine ↗</a></section>
<AlternativeFAQ faqs={faqs} title="Find the practice that fits." />
</AlternativeLayout>
<style>
.directory-hero { padding-block:80px 44px; }.directory-hero h1 { font-size:clamp(41px,6vw,78px); }.directory-hero h1 em { font:italic 1em Georgia,serif; color:#5e7858; }.directory-hero .lp-lede { max-width:65ch; }.directory-jumps { display:flex; flex-wrap:wrap; gap:12px; margin-top:48px; }.directory-jumps a { display:flex; align-items:center; gap:24px; padding:12px 16px; border:1px solid var(--lp-line); border-radius:8px; font-size:13px; }.directory-jumps a:hover { background:var(--lp-surface); }.directory-group { padding-block:48px 24px; scroll-margin-top:24px; }.directory-heading { margin-bottom:30px; }.directory-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }.directory-cards > a { border:1px solid var(--lp-line); border-radius:12px; overflow:hidden; background:var(--lp-surface); transition:transform .15s; }.directory-cards > a:hover { transform:translateY(-4px); }.directory-cards img { width:100%; aspect-ratio:1200/630; height:auto; object-fit:cover; display:block; border-bottom:1px solid var(--lp-line); }.directory-cards a > div { padding:24px; }.directory-cards h3 { font-size:19px; display:flex; justify-content:space-between; align-items:start; gap:20px; }.directory-cards h3 > span { font-size:18px; color:var(--lp-muted); }.directory-cards p { font-size:14px; margin-top:14px; }.directory-promise { padding-block:86px; }.directory-promise h2 { font-size:clamp(36px,5vw,58px); }.directory-promise em { font:italic 1em Georgia,serif; color:#5e7858; }.directory-promise p { max-width:65ch; margin-top:24px; }.directory-promise a { margin-top:28px; }@media(max-width:950px){.directory-cards { grid-template-columns:repeat(2,minmax(0,1fr)); }}@media(max-width:600px){.directory-hero { padding-top:48px; }.directory-cards { grid-template-columns:1fr; }.directory-jumps { display:grid; grid-template-columns:1fr 1fr; gap:8px; }.directory-jumps a { padding:12px; gap:10px; font-size:11px; justify-content:space-between; }.directory-group { padding-top:32px; }.directory-promise { padding-block:64px; }}
</style>
