---
import AlternativeLayout from "@/layouts/AlternativeLayout.astro";
import AlternativeFAQ from "@/components/seo/AlternativeFAQ.astro";
const faqs = [
    {
        "question": "How is NinjaType different from Nitro Type?",
        "answer": "Nitro Type combines typing races with car-collection rewards and its own game ecosystem. NinjaType focuses on configurable rooms, typing metrics and a practice routine that includes lessons and solo tests."
    },
    {
        "question": "Can my friends join the same race?",
        "answer": "Yes. Create a room, share the invitation link, choose its settings and ready up. Everyone races on the same passage. Words mode rewards a finish-line dash; Time mode gives a shared typing window."
    },
    {
        "question": "Does NinjaType include cars, teams or a teacher portal?",
        "answer": "NinjaType does not reproduce Nitro Type’s collection economy, teams or Teacher Portal. It provides its own rooms and practice tools. Review classroom requirements separately from casual friend races."
    },
    {
        "question": "What if nobody is available to race?",
        "answer": "Try Ghost Race against your fastest valid saved average pace, or take a solo typing test. Your first completed attempt can establish a baseline if you do not have one yet."
    }
];
---
<AlternativeLayout title="Nitro Type Alternative: Bring Friends to the Race | NinjaType" description="Looking for a Nitro Type alternative? Race friends in NinjaType’s free typing rooms, choose Words or Time, then build your skills with solo tests and lessons." variant="nitro" action="Enter a race" href="/multiplayer-typing-race/" competitor="Nitro Type" faqs={faqs}>

<section class="nitro-grid lp-wrap"><div><span class="lp-kicker">A Nitro Type alternative / bring the rivalry</span><h1>Same friends.<br /><em>New finish line.</em></h1><p class="lp-lede">Make NinjaType your group’s next typing hangout. Pick a race format, share the room, and turn “one more round” into a little more practice.</p><div class="lp-actions"><a class="lp-primary" href="/multiplayer-typing-race/">Start a friend race ↗</a><a class="lp-text-link" href="#race-plan">Plan your first round</a></div><p class="lp-small">Free · Nickname + security check · No account</p></div><figure class="pit-pass"><div><span>NINJATYPE</span><span>ADMIT: YOU + FRIENDS</span></div><strong>YOUR NEXT<br /><em>REMATCH.</em></strong><div class="pit-lanes" aria-label="Decorative typing race lanes"><span><b>YOU</b><i></i></span><span><b>FRIEND</b><i></i></span><span><b>FRIEND</b><i></i></span></div><div class="pit-bottom"><kbd>ready</kbd><span>WORDS / TIME</span></div><figcaption>Race illustration · no live players shown.</figcaption></figure></section>
<section class="nitro-format lp-wrap" id="race-plan"><div><span class="lp-kicker">PICK YOUR ROUND</span><h2>A dash.<br />Or a shared window.</h2></div><article><span>WORDS</span><h3>Race to the finish.</h3><p>A fixed passage gives the round a finish line. The first accepted completion can end the race, so a fast finish matters.</p></article><article><span>TIME</span><h3>Race for the whole timer.</h3><p>Everyone gets the same typing window. Compare correct-character scores when time runs out, then line up for a rematch.</p></article></section>
<section class="lp-section lp-wrap nitro-beyond"><div><span class="lp-kicker">Nitro Type vs. NinjaType</span><h2>Make the next race<br /><em>part of your progress.</em></h2><p>Nitro Type builds its racing experience around cars, collections and its own community. NinjaType gives your group a different reason to return: configurable rounds and practice tools that help you work on the typing itself.</p><p>Between races, slow down in a finger lesson or take a solo accuracy check. When you come back to the room, try applying that more deliberate movement under a little friendly pressure.</p><a class="lp-text-link" href="/blog/nitrotype-vs-ninjatype/">Read the full Nitro Type comparison ↗</a></div><aside><span>YOUR FIRST ROOM</span><ol><li>Pick a nickname and pass the security check.</li><li>Create a room and choose its settings.</li><li>Send the invitation to your friends.</li><li>Ready up together and start the round.</li><li>Compare the result. Call the rematch.</li></ol><a class="lp-primary" href="/multiplayer-typing-race/">Bring your friends ↗</a></aside></section>
<section class="nitro-solo lp-wrap"><h3>Practice doesn’t have to wait for the group.</h3><p>Ghost Race gives you a solo challenge against your saved average pace. Build a baseline today and bring it into tomorrow’s live race.</p><a class="lp-text-link" href="/ghost-race/">Race your shadow ↗</a></section>
<section class="lp-bottom-cta lp-wrap"><div><h2>Make this your regular room.</h2><p>New passage. Same friendly competition. A reason to keep typing.</p></div><a class="lp-primary" href="/multiplayer-typing-race/">Let’s race ↗</a></section>

<AlternativeFAQ faqs={faqs} title="A few things to know." />
</AlternativeLayout>
<style>

.nitro-grid { padding-block:86px; display:grid; grid-template-columns:1.1fr 1fr; gap:76px; align-items:center; }.nitro-grid h1 { font-size:clamp(45px,5.8vw,74px); }.nitro-grid h1 em,.nitro-beyond h2 em { color:var(--lp-accent); font-style:normal; }.pit-pass { margin:0 8px; padding:25px; border:1px solid #c78364; border-radius:18px; background:#ffa97c; color:#302332; transform:rotate(4deg); box-shadow:12px 12px 0 #573849; }.pit-pass > div:first-child,.pit-bottom { display:flex; justify-content:space-between; gap:16px; align-items:center; font:9px ui-monospace,monospace; }.pit-pass > strong { display:block; font:800 clamp(32px,4vw,49px)/1.05 Nunito,sans-serif; letter-spacing:-.06em; margin-top:32px; }.pit-pass strong em { font-style:normal; }.pit-lanes { margin-block:26px; }.pit-lanes > span { display:flex; align-items:center; height:42px; gap:15px; border-bottom:1px dashed #784d4c66; }.pit-lanes b { width:50px; font:9px ui-monospace,monospace; }.pit-lanes i { height:7px; width:62%; background:#302332; border-radius:3px; }.pit-lanes > span:nth-child(2) i { width:43%; opacity:.55; }.pit-lanes > span:nth-child(3) i { width:51%; opacity:.75; }.pit-bottom kbd { padding:8px 28px; background:#ffd6bb; border:1px solid #784d4c; border-bottom-width:4px; border-radius:7px; font:12px ui-monospace,monospace; }.pit-pass figcaption { margin-top:20px; font-size:10px; }.nitro-format { display:grid; grid-template-columns:1.1fr 1fr 1fr; gap:36px; padding-block:48px; border-block:1px solid var(--lp-line); }.nitro-format h2 { font-size:34px; }.nitro-format article > span { color:var(--lp-accent); font:12px ui-monospace,monospace; }.nitro-format h3 { margin-top:20px; }.nitro-format p { margin-top:14px; font-size:14px; }.nitro-beyond { display:grid; grid-template-columns:1.1fr 1fr; gap:80px; }.nitro-beyond p { margin-top:24px; }.nitro-beyond > div a { margin-top:24px; font-size:13px; }.nitro-beyond aside { padding:32px; border:1px solid var(--lp-line); background:var(--lp-surface); border-radius:12px; }.nitro-beyond aside > span { font:11px ui-monospace,monospace; color:var(--lp-accent); }.nitro-beyond ol { padding-left:20px; margin-block:26px; }.nitro-beyond li { padding:8px 0 8px 8px; font-size:15px; color:var(--lp-muted); }.nitro-solo { padding-bottom:64px; }.nitro-solo p { margin-top:18px; max-width:70ch; }.nitro-solo a { margin-top:18px; }@media(max-width:800px){.nitro-grid { grid-template-columns:1fr; padding-block:48px 70px; gap:50px; }.pit-pass { width:min(420px,calc(100% - 24px)); justify-self:center; }.nitro-format { grid-template-columns:1fr; gap:30px; }.nitro-format article { padding-top:24px; border-top:1px solid var(--lp-line); }.nitro-beyond { grid-template-columns:1fr; gap:34px; }}

</style>
