---
import AlternativeLayout from "@/layouts/AlternativeLayout.astro";
import AlternativeFAQ from "@/components/seo/AlternativeFAQ.astro";
const faqs = [
    {
        "question": "What does a typing speed test measure?",
        "answer": "A typing speed test measures typing output over time, usually in words per minute, alongside accuracy. A standard WPM word is five characters, rather than one dictionary word."
    },
    {
        "question": "How does NinjaType calculate WPM?",
        "answer": "WPM uses character count divided by five and elapsed minutes. NinjaType’s solo analytics distinguish raw and correct WPM; multiplayer uses correct-character WPM. Read accuracy too, because fast output and correct output are different measures."
    },
    {
        "question": "Which test duration should I choose?",
        "answer": "A one-minute test is a practical baseline. Short tests are quick checks; longer tests add a concentration and pacing challenge. Choose a duration in Time mode, or use Words mode for a fixed passage."
    },
    {
        "question": "How can I compare my results fairly?",
        "answer": "Keep your keyboard, mode, dictionary and duration consistent. Complete several attempts instead of reporting only the fastest one. NinjaType saves completed attempts in local history so you can review the pattern."
    }
];
---
<AlternativeLayout title="Typing Speed Test: Find Your WPM & Next Step | NinjaType" description="Take a free typing speed test with NinjaType. Measure WPM and accuracy, choose your test length, review local history and build a repeatable daily practice habit." variant="speed" action="Test your typing" href="/" pageLabel="Typing speed test" faqs={faqs}>

<section class="speed-hero lp-wrap"><span class="lp-kicker">Free typing speed test / know your starting point</span><div class="speed-opening"><h1>Your speed.<br />Your accuracy.<br /><em>Your next step.</em></h1><div><p class="lp-lede">Find out how you type today. Then make NinjaType the place you return to for a clearer result, a focused lesson, and another chance to improve.</p><div class="lp-actions"><a class="lp-primary" href="/">Take the free typing test ↗</a></div><p class="lp-small">No account · Choose Time, Words or Quotes</p></div></div><div class="speed-equation"><span>WHAT A WPM NUMBER MEANS</span><div><strong>250</strong><i>÷</i><strong>5</strong><i>÷</i><strong>1</strong><i>=</i><strong class="answer">50</strong></div><div class="equation-labels"><span>characters</span><span>per standard word</span><span>minute</span><span>WPM</span></div><p>Worked example, not your result. Correct WPM uses correctly matched characters.</p></div></section>
<section class="lp-section lp-wrap speed-read"><div><span class="lp-kicker">Make the result useful</span><h2>There’s more to a test<br />than the biggest number.</h2><p>Speed tells you how quickly you produced text. Accuracy helps you see how cleanly you typed it. Read them together before choosing the next exercise.</p><a class="lp-text-link" href="/blog/typing-speed-test-wpm/">Understand raw and correct WPM ↗</a></div><dl><div><dt>WPM</dt><dd>A pace expressed in standard five-character words per minute. Test content and scoring rules affect comparisons.</dd></div><div><dt>Accuracy</dt><dd>A view of mistakes in the attempt. Review it alongside speed instead of trading careful typing for a higher number.</dd></div><div><dt>Consistency</dt><dd>The pattern across comparable attempts. Your local history is a better reference than one unusually fast run.</dd></div></dl></section>
<section class="speed-plan lp-wrap"><span class="lp-kicker">Your first useful baseline</span><h2>Three attempts.<br />One clearer picture.</h2><div class="speed-steps"><article><b>01</b><h3>Get comfortable.</h3><p>Choose a familiar dictionary and one-minute duration. Take a relaxed warm-up before counting your baseline.</p></article><article><b>02</b><h3>Keep the setup steady.</h3><p>Complete three tests with the same settings. Pause briefly between them and note both WPM and accuracy.</p></article><article><b>03</b><h3>Give the next session a focus.</h3><p>Use the middle WPM as a simple reference, then practise one recurring mistake. This is a routine, not a certification.</p></article></div></section>
<section class="lp-section lp-wrap"><div class="lp-pair"><article><h3>Find the keys with less hesitation.</h3><p>Use NinjaType’s QWERTY finger lessons when looking down or searching for a reach breaks your rhythm. Work slowly before testing again.</p><a class="lp-text-link" href="/learn/">Learn touch typing ↗</a></article><article><h3>Give tomorrow a reason to happen.</h3><p>Revisit your history, build a gentle daily streak, or share an attempt you’re proud of. When you want company, invite friends to a typing race.</p><a class="lp-text-link" href="/multiplayer-typing-race/">Race with friends ↗</a></article></div></section>
<section class="lp-bottom-cta lp-wrap"><div><h2>Start your typing story here.</h2><p>Your first result gives you a starting point. Make NinjaType your daily practice tab.</p></div><a class="lp-primary" href="/">Find your WPM ↗</a></section>

<AlternativeFAQ faqs={faqs} title="A few things to know." />
</AlternativeLayout>
<style>

.speed-hero { padding-block:76px 40px; }.speed-opening { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:end; }.speed-opening h1 { font-size:clamp(44px,5.7vw,72px); }.speed-opening em { font-style:normal; color:#357d7c; }.speed-opening .lp-lede { margin-top:0 !important; }.speed-equation { margin-top:56px; border:1px solid var(--lp-line); border-radius:16px; padding:32px 40px; background:#fafffb; }.speed-equation > span { font:10px ui-monospace,monospace; letter-spacing:.14em; color:var(--lp-muted); }.speed-equation > div:not(.equation-labels) { display:grid; grid-template-columns:1fr 24px 1fr 24px 1fr 24px 1fr; align-items:center; text-align:center; margin-top:30px; }.speed-equation strong { font:clamp(38px,6vw,74px)/1.2 ui-monospace,monospace; letter-spacing:-.07em; }.speed-equation i { font-size:26px; font-style:normal; color:#77958c; }.speed-equation .answer { color:#2f7776; }.equation-labels { display:grid; grid-template-columns:repeat(4,1fr); gap:24px; text-align:center; margin-top:16px; font-size:11px; color:var(--lp-muted); }.speed-equation p { margin-top:30px; font-size:11px; }.speed-read { display:grid; grid-template-columns:1fr 1fr; gap:80px; }.speed-read > div p { margin-top:26px; }.speed-read a { margin-top:24px; font-size:14px; }.speed-read dl { margin:0; }.speed-read dl > div { padding:24px 0; border-bottom:1px solid var(--lp-line); }.speed-read dl > div:first-child { padding-top:0; }.speed-read dt { font-size:23px; font-weight:750; }.speed-read dd { margin:12px 0 0; color:var(--lp-muted); font-size:15px; }.speed-plan { background:#d6eae4; padding:44px; border-radius:14px; }.speed-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:40px; margin-top:38px; }.speed-steps b { font:13px ui-monospace,monospace; }.speed-steps h3 { margin-top:22px; }.speed-steps p { margin-top:16px; font-size:14px; }@media(max-width:750px){.speed-hero { padding-top:48px; }.speed-opening,.speed-read,.speed-steps { grid-template-columns:1fr; gap:30px; }.speed-equation { padding:26px 16px; }.speed-equation strong { font-size:34px; }.speed-equation i { font-size:18px; }.speed-equation > div:not(.equation-labels) { grid-template-columns:1fr 14px 1fr 14px 1fr 14px 1fr; }.equation-labels { font-size:9px; gap:12px; }.speed-plan { padding:28px; }}

</style>
