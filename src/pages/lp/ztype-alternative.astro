---
import AlternativeLayout from "@/layouts/AlternativeLayout.astro";
import AlternativeFAQ from "@/components/seo/AlternativeFAQ.astro";
const faqs = [
    {
        "question": "Is NinjaType Ghost Race a space-shooter like ZType?",
        "answer": "No. ZType is a type-to-shoot game. Ghost Race is a typing passage challenge against a shadow based on your saved average WPM. It offers a different kind of game motivation."
    },
    {
        "question": "What does the ghost represent?",
        "answer": "The ghost uses your fastest valid saved average pace on a fresh passage. It is not a replay of individual keystrokes. If no baseline exists yet, complete a run to establish one."
    },
    {
        "question": "Do I need another player to start?",
        "answer": "No. Ghost Race is a solo mode, so there is no live opponent to arrange. For real-time competition with friends, use NinjaType’s multiplayer typing rooms."
    },
    {
        "question": "Will playing replace touch typing lessons?",
        "answer": "A game can give you a reason to practise, but a difficult finger movement may need a slower exercise. NinjaType lets you switch from Ghost Race to QWERTY lessons or a solo accuracy test."
    }
];
---
<AlternativeLayout title="ZType Alternative: Race Your Own Typing Shadow | NinjaType" description="Want a ZType alternative? Try NinjaType Ghost Race against your saved typing pace, then explore free finger lessons, typing tests and live friend races." variant="ztype" action="Try Ghost Race" href="/ghost-race/" competitor="ZType" faqs={faqs}>

<section class="orbit-hero lp-wrap"><span class="lp-kicker">A ZType alternative / another way to play</span><h1>Your next opponent<br /><em>could be you.</em></h1><p class="lp-lede">Turn your saved typing pace into a challenge worth returning to. NinjaType Ghost Race gives you a fresh passage, a shadow to follow, and a finish line of your own.</p><div class="lp-actions"><a class="lp-primary" href="/ghost-race/">Race your typing shadow ↗</a><a class="lp-text-link" href="#ghost">Meet your ghost</a></div><figure class="orbit-art"><div class="orbit-circle" aria-hidden="true"></div><div class="orbit-star star-a" aria-hidden="true">✦</div><div class="orbit-star star-b" aria-hidden="true">✧</div><div class="orbit-track"><span>YOUR SAVED PACE</span><p><u>small steps</u> <mark>new</mark> horizons<i aria-hidden="true">▏</i></p><div><span>YOUR WORDS</span><span>YOUR FINISH LINE ↗</span></div></div><figcaption>Ghost Race illustration · not a live result.</figcaption></figure></section>
<section class="lp-section lp-wrap orbit-explain" id="ghost"><div><span class="lp-kicker">A familiar pace on a fresh passage</span><h2>You set the benchmark.<br /><em>Then you chase it.</em></h2><p>Choose a 15, 30 or 50-word track. Ghost Race projects your fastest valid saved average WPM onto the passage. The shadow gives you a moving reference while you focus on typing the words correctly.</p><p>It is an average-pace challenge, not a replay of your old keystrokes. Every fresh passage is another opportunity to apply the skill instead of memorizing one run.</p><a class="lp-text-link" href="/ghost-race/">Set your first benchmark ↗</a></div><div class="orbit-manual"><article><span>01 / NO BASELINE YET?</span><h3>Start with one finish.</h3><p>Complete your first run to give future practice a reference.</p></article><article><span>02 / TOO MUCH PRESSURE?</span><h3>Slow the session down.</h3><p>Return to a solo test or lesson. Work on accuracy before another chase.</p></article><article><span>03 / WANT LIVE COMPANY?</span><h3>Bring a friend to the track.</h3><p>Create a multiplayer room and race on the same text together.</p></article></div></section>
<section class="orbit-choice lp-wrap"><span class="lp-kicker">ZType vs. NinjaType</span><h2>Different games.<br />A good reason to type.</h2><div class="lp-pair"><article><h3>ZType: type to shoot</h3><p>ZType turns words into targets in a space-shooter game. Its arcade challenge is built around completing words as part of that battle.</p></article><article><h3>NinjaType: type toward your next finish</h3><p>Ghost Race centers on completing a passage against your saved pace. NinjaType adds lessons, solo tests and friend rooms, so the game can be one part of your daily typing routine.</p><p>It does not recreate ZType’s ships or combat. Come here for a personal pace challenge with a place to practise the movements behind it.</p></article></div><a class="lp-text-link" href="/blog/typing-games-for-adults/">Explore typing games and practice ideas ↗</a></section>
<section class="lp-bottom-cta lp-wrap"><div><h2>Make your next level personal.</h2><p>Start a run today. Give yourself a reason to come back to NinjaType.</p></div><a class="lp-primary" href="/ghost-race/">Start Ghost Race ↗</a></section>

<AlternativeFAQ faqs={faqs} title="A few things to know." />
</AlternativeLayout>
<style>

.orbit-hero { padding-block:80px 30px; text-align:center; }.orbit-hero h1 { font-size:clamp(43px,6vw,78px); }.orbit-hero em,.orbit-explain h2 em { color:#d2b8ff; font-style:normal; }.orbit-hero .lp-lede { margin-inline:auto; max-width:65ch; }.orbit-hero .lp-actions { justify-content:center; }.orbit-art { position:relative; margin:60px 0 0; height:320px; overflow:hidden; border-block:1px solid var(--lp-line); background:radial-gradient(ellipse at center,#36335b66,transparent 65%); display:grid; place-items:center; }.orbit-circle { position:absolute; width:650px; height:220px; border:1px solid #8880b34d; border-radius:50%; transform:rotate(-17deg); }.orbit-circle::after { content:''; position:absolute; inset:-45px 70px; border:1px solid #8880b32b; border-radius:50%; transform:rotate(38deg); }.orbit-star { position:absolute; color:#d2b8ff; }.star-a { top:40px; right:16%; font-size:30px; }.star-b { bottom:48px; left:12%; font-size:20px; }.orbit-track { position:relative; width:min(700px,calc(100% - 40px)); padding:24px; text-align:left; background:#171c33; border:1px solid #56577e; border-radius:10px; transform:rotate(-3deg); }.orbit-track > span { font:9px ui-monospace,monospace; color:#b8bbd7; }.orbit-track p { font:clamp(18px,3vw,32px)/1.5 ui-monospace,monospace; margin:24px 0; }.orbit-track u { color:#f2f0ff; text-decoration-color:#d2b8ff; text-underline-offset:8px; }.orbit-track mark { color:#d2b8ff; background:none; }.orbit-track i { color:#d2b8ff; font-style:normal; }.orbit-track > div { display:flex; justify-content:space-between; gap:16px; font:8px ui-monospace,monospace; color:#b8bbd7; }.orbit-art figcaption { position:absolute; bottom:14px; font-size:10px; color:#b8bbd7; }.orbit-explain { display:grid; grid-template-columns:1fr 1fr; gap:80px; }.orbit-explain > div > p { margin-top:24px; }.orbit-explain a { margin-top:24px; font-size:14px; }.orbit-manual article { padding:28px 0; border-top:1px solid var(--lp-line); }.orbit-manual article:first-child { padding-top:0; border:0; }.orbit-manual span { font:10px ui-monospace,monospace; color:#d2b8ff; }.orbit-manual h3 { margin-top:18px; }.orbit-manual p { margin-top:14px; font-size:15px; }.orbit-choice { padding-block:40px 80px; }.orbit-choice .lp-pair { margin-top:36px; }.orbit-choice > a { margin-top:24px; font-size:14px; }@media(max-width:750px){.orbit-hero { padding-top:48px; }.orbit-explain { grid-template-columns:1fr; gap:36px; }.orbit-art { height:300px; margin-top:40px; }.orbit-track { padding:20px 16px; }.orbit-track p { font-size:18px; }.orbit-track > div { font-size:7px; }}

</style>
