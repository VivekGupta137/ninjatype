---
import AlternativeLayout from '@/layouts/AlternativeLayout.astro';
import AlternativeFAQ from '@/components/seo/AlternativeFAQ.astro';
const faqs = [
    { question: 'What makes NinjaType an alternative to GeekTyper?', answer: 'NinjaType offers keyboard-driven simulated code in a workspace with seven panels. You can change the terminal colors, resize desktop panes, hide panels and run a staged sequence with a configurable result. It is a different take on the fictional hacker-screen experience.' },
    { question: 'Is this free, and do I need to install anything?', answer: 'NinjaType Hacker Typer is free to use in your browser. No account, download or programming knowledge is required. Open the simulator, click the editor and type letters to reveal code.' },
    { question: 'Can I use GeekTyper themes in NinjaType?', answer: 'NinjaType does not import GeekTyper themes. It has its own green, amber, cyan and Mono terminal palettes, along with controls for panel visibility and desktop panel sizes.' },
    { question: 'Does the fake hacker screen work on a phone?', answer: 'Yes. On mobile, use the Type button to open keyboard input, or Run to start the sequence. Tabs follow the active stages automatically. Desktop gives you more space to show several panels at once.' },
    { question: 'Does the simulator actually hack anything?', answer: 'No. The source text, system activity, network display and progress indicators are visual simulations. They do not access other computers or execute the displayed code.' },
];
const palettes = [{ id: 'green', label: 'Green', color: '#96ff85' }, { id: 'amber', label: 'Amber', color: '#ffc46b' }, { id: 'cyan', label: 'Cyan', color: '#7ce8ff' }, { id: 'mono', label: 'Mono', color: '#eeeeee' }];
---
<AlternativeLayout title="GeekTyper Alternative: Make the Terminal Yours | NinjaType" description="Try a free GeekTyper alternative with seven terminal panels, four color themes and a configurable Access Granted finale. Open NinjaType Hacker Typer in your browser." competitor="GeekTyper" variant="geek" action="Open terminal" href="/hacker-typer/" faqs={faqs}>
    <section class="geek-hero lp-wrap">
        <div class="geek-heading"><span class="lp-kicker">~/ alternatives / geektyper</span><h1>Same hacker energy.<br /><span>Your kind of terminal.</span></h1></div>
        <div class="geek-intro"><p class="lp-lede">A free GeekTyper alternative for anyone who loves a screen full of code. Shape the workspace, set the color, and turn a few keypresses into a whole scene.</p><div class="lp-actions"><a class="lp-primary" href="/hacker-typer/">Open Hacker Typer <span aria-hidden="true">↗</span></a><a class="lp-text-link" href="#workspace">Explore the workspace</a></div><p class="lp-small">No download. No account. Just your keyboard.</p></div>
        <fieldset class="geek-preview"><legend>Pick a color. Find your atmosphere.</legend>
            {palettes.map(({id,label,color},i) => <Fragment><input type="radio" name="terminal-preview" id={`preview-${id}`} value={id} checked={i === 0} /><label for={`preview-${id}`} style={`--swatch:${color}`}><i aria-hidden="true"></i>{label}</label></Fragment>)}
            <div class="geek-screen" aria-label="Illustrated terminal workspace; theme controls change this preview only">
                <div class="screen-chrome"><span><i></i><i></i><i></i></span><span>NINJATYPE / WORKSPACE PREVIEW</span><span>SIMULATION</span></div>
                <div class="screen-grid"><div class="code-pane"><div class="pane-label">01 / EDITOR <span>● IDLE</span></div><pre><span>/* a little movie magic */</span>

const scene = createScene(&#123;
  theme: <b>"your style"</b>,
  workspace: <b>"your rules"</b>
&#125;);

<span>// you bring the keystrokes.</span>
<span>// we bring the atmosphere.</span>

scene.<b>ready</b>();<span class="code-cursor">▌</span></pre><div class="screen-hint"><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><span>Your keyboard takes it from here.</span></div></div>
                    <div class="monitor-pane"><div class="pane-label">02 / PROCESSES</div><div class="monitor-bars" aria-hidden="true">{[28,52,39,68,48,82,58,38,72,53,89,64,41,58,32,74].map(height => <i style={`height:${height}%`}></i>)}</div><div class="monitor-caption">SYSTEM ACTIVITY / SIMULATED</div></div>
                    <div class="network-pane"><div class="pane-label">03 / NETWORK</div><svg viewBox="0 0 300 110" role="img" aria-label="Decorative network nodes"><path d="M30 55H95L150 20L220 55H275M95 55L150 95L220 55M150 20V95" fill="none" stroke="currentColor" stroke-opacity=".4" /><g fill="currentColor"><circle cx="30" cy="55" r="4"/><circle cx="95" cy="55" r="6"/><circle cx="150" cy="20" r="5"/><circle cx="150" cy="95" r="5"/><circle cx="220" cy="55" r="6"/><circle cx="275" cy="55" r="4"/></g><circle cx="95" cy="55" r="15" fill="none" stroke="currentColor" stroke-opacity=".5" /></svg></div>
                </div><div class="screen-bottom"><span>EDITOR · PROCESSES · NETWORK · +4 PANELS</span><span>READY WHEN YOU ARE ↵</span></div>
            </div>
            <p class="preview-note">An illustrated preview. Choose your theme again inside the simulator.</p>
        </fieldset>
    </section>
    <section class="lp-wrap geek-workspace lp-section" id="workspace"><div class="geek-sidebar"><span class="lp-kicker">01 / Arrange the atmosphere</span><h2>More than a<br />wall of code.</h2><p>GeekTyper’s themed scenes make it easy to step into a fictional world. NinjaType puts the terminal workspace at the center of the experience.</p><a class="lp-text-link" href="/hacker-typer/">Make it yours ↗</a></div><div class="geek-features">
        <article><span aria-hidden="true">▦</span><div><h3>Seven panes. One scene.</h3><p>Code, processes, network, memory, disassembly, payload and transfer. Keep the supporting activity visible, or let the editor take the spotlight.</p></div></article>
        <article><span aria-hidden="true">↔</span><div><h3>A workspace that fits the shot.</h3><p>Drag desktop dividers to change the balance. Hide individual panels in Settings, then restore them when you want the full control-room look.</p></div></article>
        <article><span aria-hidden="true">↵</span><div><h3>Give the scene an ending.</h3><p>Press Run or Enter to begin the staged operation. Configure an Access Granted or Access Denied message, preview it, and replay the sequence.</p></div></article>
    </div></section>
    <section class="geek-compare lp-wrap lp-section" id="compare"><span class="lp-kicker">02 / GeekTyper vs. NinjaType</span><h2>Two ways to play the part.</h2><div class="geek-choices"><article><span class="choice-label">THE FAMILIAR</span><h3>GeekTyper</h3><p>A collection of themed fictional hacking screens. Random keypresses reveal code, with hotkeys for extra effects.</p><p>Its focus is choosing a ready-made scene inspired by films and games.</p></article><article><span class="choice-label">A DIFFERENT DIRECTION</span><h3>NinjaType Hacker Typer</h3><p>A terminal workspace with four palettes, adjustable desktop panes and a staged Run sequence.</p><p>Make NinjaType your go-to terminal: shape the screen around your editor, supporting activity and your own result message.</p><a class="lp-text-link" href="/hacker-typer/">Try NinjaType ↗</a></article></div><p class="lp-sources">These are visual simulators, not hacking tools or typing speed tests. Read our <a href="/hacker-typer/blog/geektyper-vs-hacker-typer/">GeekTyper and Hacker Typer guide</a> for more context. External product features can change.</p></section>
    <section class="geek-command lp-wrap"><div><span class="lp-kicker">Your next scene starts here</span><h2><span aria-hidden="true">&gt; </span>make yourself at home<span class="command-cursor" aria-hidden="true">_</span></h2><p>Pick a palette. Set the panes. Let your keyboard do the acting.</p></div><a class="lp-primary" href="/hacker-typer/">Launch the simulator <span aria-hidden="true">↗</span></a></section>
    <AlternativeFAQ faqs={faqs} title="A little context before you type." />
</AlternativeLayout>
<style>
    .geek-hero { padding-block:76px 60px; display:grid; grid-template-columns:1.2fr 1fr; gap:42px 60px; }.geek-heading { grid-column:1 / -1; }.geek-hero h1 { font-size:clamp(42px,6.5vw,82px); }.geek-hero h1 span { color:var(--lp-accent); }.geek-intro { grid-column:1 / -1; display:grid; grid-template-columns:1.1fr 1fr; gap:0 70px; }.geek-intro .lp-lede { margin-top:0 !important; grid-row:span 2; max-width:52ch; }.geek-intro .lp-actions { margin-top:0; }.geek-intro .lp-small { margin-top:10px !important; }
    .geek-preview { grid-column:1 / -1; min-width:0; padding:0; border:0; margin:20px 0 0; }.geek-preview legend { font:11px/1.5 ui-monospace,monospace; color:var(--lp-muted); margin-bottom:14px; }.geek-preview input { position:absolute; opacity:0; width:1px; height:1px; }.geek-preview label { display:inline-flex; align-items:center; gap:9px; margin:0 8px 20px 0; padding:10px 14px; border:1px solid var(--lp-line); border-radius:5px; font:12px/1.5 ui-monospace,monospace; cursor:pointer; }.geek-preview label i { width:12px; height:12px; border-radius:50%; background:var(--swatch); }.geek-preview input:checked + label { border-color:var(--swatch); background:#ffffff0a; }.geek-preview input:focus-visible + label { outline:2px solid var(--swatch); outline-offset:4px; }
    .geek-screen { --terminal:#96ff85; color:var(--terminal); border:1px solid color-mix(in srgb,var(--terminal) 38%,transparent); border-radius:10px; background:#050907; box-shadow:0 24px 100px #96ff8509; overflow:hidden; }.geek-preview input[value=amber]:checked ~ .geek-screen { --terminal:#ffc46b; }.geek-preview input[value=cyan]:checked ~ .geek-screen { --terminal:#7ce8ff; }.geek-preview input[value=mono]:checked ~ .geek-screen { --terminal:#eee; }
    .screen-chrome { display:flex; justify-content:space-between; align-items:center; gap:14px; padding:16px 22px; border-bottom:1px solid #ffffff19; font:10px ui-monospace,monospace; letter-spacing:.08em; }.screen-chrome > span:first-child { display:flex; gap:6px; }.screen-chrome i { width:7px; height:7px; border:1px solid currentColor; border-radius:50%; }.screen-chrome > span:last-child { opacity:.7; }.screen-grid { display:grid; grid-template-columns:1.7fr 1fr; }.code-pane { grid-row:span 2; padding:24px 30px; border-right:1px solid #ffffff19; min-width:0; }.pane-label { display:flex; justify-content:space-between; gap:16px; font:9px ui-monospace,monospace; letter-spacing:.09em; opacity:.8; }.code-pane pre { margin:32px 0; padding:0; background:transparent; color:inherit; border:0; font:clamp(11px,1.4vw,16px)/1.8 ui-monospace,monospace; white-space:pre-wrap; overflow-wrap:anywhere; }.code-pane pre span:not(.code-cursor) { opacity:.6; }.code-pane pre b { font-weight:400; color:#f4fff6; }.screen-hint { display:flex; gap:6px; align-items:center; font:10px ui-monospace,monospace; }.screen-hint kbd { border:1px solid #ffffff40; border-bottom-width:3px; border-radius:4px; padding:6px 9px; }.screen-hint > span { margin-left:10px; color:#a6baac; }.monitor-pane,.network-pane { padding:24px; min-width:0; }.monitor-pane { border-bottom:1px solid #ffffff19; }.monitor-bars { display:flex; gap:8px; align-items:end; height:95px; margin-top:26px; }.monitor-bars i { flex:1; background:currentColor; opacity:.65; }.monitor-caption { font:8px ui-monospace,monospace; margin-top:20px; opacity:.7; }.network-pane svg { display:block; width:100%; height:110px; margin-top:14px; }.screen-bottom { display:flex; justify-content:space-between; gap:20px; border-top:1px solid #ffffff19; padding:14px 22px; font:9px/1.6 ui-monospace,monospace; opacity:.75; }.preview-note { font-size:11px; margin-top:16px !important; }
    .geek-workspace { display:grid; grid-template-columns:1fr 1.2fr; gap:100px; border-top:1px solid var(--lp-line); }.geek-sidebar p { margin-top:24px; max-width:36ch; }.geek-sidebar a { margin-top:20px; font-size:14px; }.geek-features article { display:flex; gap:26px; padding:30px 0; border-top:1px solid var(--lp-line); }.geek-features article:first-child { padding-top:0; border:0; }.geek-features article > span { font:30px/1.3 ui-monospace,monospace; color:var(--lp-accent); width:38px; flex-shrink:0; }.geek-features p { margin-top:14px; font-size:15px; }
    .geek-compare { border-top:1px solid var(--lp-line); }.geek-choices { display:grid; grid-template-columns:1fr 1fr; margin-top:40px; border:1px solid var(--lp-line); }.geek-choices article { padding:40px; }.geek-choices article:last-child { border-left:1px solid var(--lp-line); background:var(--lp-surface); }.choice-label { display:block; font:10px ui-monospace,monospace; letter-spacing:.1em; color:var(--lp-muted); margin-bottom:26px; }.geek-choices article:last-child .choice-label { color:var(--lp-accent); }.geek-choices h3 { font-size:27px; }.geek-choices p { margin-top:20px; font-size:15px; }.geek-choices a { margin-top:22px; font-size:13px; }
    .geek-command { display:flex; justify-content:space-between; align-items:center; gap:32px; border-block:1px solid var(--lp-accent); padding-block:48px; margin-bottom:80px; }.geek-command h2 { font:clamp(23px,3vw,34px)/1.3 ui-monospace,monospace; letter-spacing:-.05em; }.geek-command h2 > span { color:var(--lp-accent); }.geek-command p { margin-top:18px; font-size:14px; }.geek-command .lp-primary { flex-shrink:0; }
    @media(max-width:800px) { .geek-hero { padding-top:48px; gap:30px; }.geek-intro { grid-template-columns:1fr; gap:26px; }.geek-intro .lp-small { margin-top:-12px !important; }.geek-workspace { grid-template-columns:1fr; gap:40px; }.geek-sidebar p { max-width:55ch; }.geek-command { flex-direction:column; align-items:start; }.geek-choices article { padding:26px; }.screen-hint > span { display:none; }.code-pane { padding:20px; }.monitor-pane,.network-pane { padding:20px; }.monitor-bars { gap:4px; } }
    @media(max-width:560px) { .geek-preview label { padding:10px; margin-right:3px; font-size:11px; gap:6px; }.screen-chrome { padding:14px; font-size:8px; }.screen-chrome > span:last-child { display:none; }.screen-grid { grid-template-columns:1fr 1fr; }.code-pane { grid-column:1 / -1; grid-row:auto; border-right:0; border-bottom:1px solid #ffffff19; }.code-pane pre { font-size:12px; margin-block:24px; }.monitor-pane { border-bottom:0; border-right:1px solid #ffffff19; }.monitor-pane,.network-pane { padding:16px 12px; }.monitor-bars { height:60px; margin-top:20px; }.monitor-caption { font-size:7px; }.network-pane svg { height:95px; margin:10px 0 0; }.screen-bottom { padding:12px; font-size:8px; }.screen-bottom > span:last-child { display:none; }.geek-choices { grid-template-columns:1fr; }.geek-choices article:last-child { border-left:0; border-top:1px solid var(--lp-line); }.geek-features article { gap:16px; } }
</style>
