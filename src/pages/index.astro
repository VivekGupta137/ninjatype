---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import ConfigToolbar from "@/components/ConfigToolbar";
import KeyboardContainer from "@/components/KeyboardContainer";
import Footer from "@/components/Footer";
import AnalyticsContainer from "@/components/analytics/AnalyticsContainer.astro";
import BottomToolbar from "@/components/toolbar/BottomToolbar";
import PageFAQ from "@/components/seo/PageFAQ.astro";
import PracticeHelp from "@/components/seo/PracticeHelp.astro";
import { mainPageFAQs } from "@/constants/faq";
import {
    getOrganizationSchema,
    getWebsiteSchema,
    getWebApplicationSchema,
    getWebPageSchema,
    getFAQPageSchema,
    createSchemaGraph,
} from "@/lib/schema-templates";

const title = 'Typing Ninja Practice & Free Typing Test | NinjaType';
const description = 'Train like a typing ninja with a free typing test, touch typing practice and typing games. Measure WPM and accuracy, learn weak keys, and race friends.';
const canonicalURL = new URL("/", Astro.site || Astro.url.origin).href;

const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: title, description }),
    getWebApplicationSchema({ url: canonicalURL, name: title, description, features: ['Word and timed typing tests', 'WPM and accuracy results', 'Local typing history', 'Customizable themes'] }),
    getFAQPageSchema(mainPageFAQs),
);
---

<BaseLayout
    title={title}
    description={description}
    canonical={canonicalURL} includeApplicationSchema={false}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(schemaMarkup)}
    />

    <div id="body-container" class="analytics-page">
        <Header />

        <main id="main-content">
            <h1 class="sr-only">Typing ninja practice and free typing test</h1>
            <div id="main-container">
                <ConfigToolbar client:load />
                <KeyboardContainer client:load />
            </div>
            <AnalyticsContainer />
            <BottomToolbar client:load />
            <PracticeHelp>
                <h3>Train like a typing ninja with NinjaType</h3>
                <p>Build accurate keyboard habits with a free typing test, <a href="/learn/">touch typing practice</a> and a <a href="/multiplayer-typing-race/">typing race with friends</a>. Choose the exercise that fits your next goal, then compare completed results.</p>
                <h3>Test your typing speed and accuracy</h3>
                <ol>
                    <li>Choose a word count or timed typing test and a dictionary in the controls above.</li>
                    <li>Focus the typing area and copy the passage. Review your WPM, accuracy, and highlighted mistakes.</li>
                    <li>Repeat with the same settings and compare your saved results in <a href="/history/">typing history</a>.</li>
                </ol>
                <h3>Find your next typing exercise</h3>
                <p>New to the keyboard? Try our <a href="/learn/">free touch typing lessons</a> for home row and finger placement practice. For typing games, <a href="/multiplayer-typing-race/">race with friends</a> or <a href="/ghost-race/">challenge your personal best in Ghost Race</a>.</p>
                <PageFAQ title="Typing test FAQ" faqs={mainPageFAQs} />
                <p><a href="/help/">Help with lessons, multiplayer, and Ghost Race →</a></p>
            </PracticeHelp>
        </main>

        <Footer />
    </div>
</BaseLayout>
<script>
    import { $kbState, $kbTypingState } from "@/store/keyboard";

    function applyKeyboardState() {
        if (window.location.pathname !== "/") return;
        document.body.setAttribute("data-kb-state", $kbState.get().toString());
        document.body.setAttribute(
            "data-kb-typing-state",
            $kbTypingState.get().toString(),
        );
    }

    $kbState.subscribe(applyKeyboardState);
    $kbTypingState.subscribe(applyKeyboardState);
    // Returning from history replaces the body without rerunning this script.
    document.addEventListener("astro:page-load", applyKeyboardState);
</script>
