---
import Footer from '@/components/Footer';
import Header from '@/components/Header.astro';
import { FaqSection } from '@/components/ui/Faq';
import HowToRace from '@/components/multiplayer/HowToRace';
import MultiplayerContainer from '@/components/multiplayer/MultiplayerContainer';
import TrainingGuides from '@/components/blog/TrainingGuides.astro';
import { multiplayerPageFAQs } from '@/constants/faq';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getOrganizationSchema, getWebsiteSchema, getWebApplicationSchema, getWebPageSchema, getFAQPageSchema, createSchemaGraph } from '@/lib/schema-templates';
import '../styles/online.css';
import '../styles/multiplayer.css';

const title = 'Typing Race: Free Multiplayer Typing Game | NinjaType';
const description = 'Play a free multiplayer typing game with friends or join a public room. Choose a timed or word race, compare WPM and accuracy, and rematch. No sign-up.';
const canonicalURL = new URL('/multiplayer-typing-race/', Astro.site || Astro.url.origin).href;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: title, description }),
    getWebApplicationSchema({ url: canonicalURL, name: title, description, features: ['Invite friends or join public rooms', 'Words and Time races', 'Shared passages and countdown', 'WPM and accuracy comparison', 'Rematches'] }),
    getFAQPageSchema(multiplayerPageFAQs),
);
---
<BaseLayout title={title} description={description} canonical={canonicalURL} includeApplicationSchema={false}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="multiplayer-page">
            <MultiplayerContainer client:load />
            <div class="online-workspace multiplayer-workspace multiplayer-learn-more">
                <HowToRace client:visible />
                <p class="multiplayer-guide-link">Want a solo round? Try <a href="/ghost-race/">Ghost Race</a>, <a href="/">typing practice</a>, or <a href="/learn/">free touch typing lessons</a>.</p>
                <p class="multiplayer-guide-link">Looking for a TypeRacer alternative? Explore our <a href="/lp/typeracer-alternative/">TypeRacer alternative comparison</a> to compare the experience and choose your next typing game.</p>
                <TrainingGuides app="multiplayer" />
                <FaqSection client:visible title="Multiplayer typing test FAQ" faqs={multiplayerPageFAQs} />
            </div>
        </main>
        <Footer />
    </div>
</BaseLayout>
<script>
    // The help link opens its disclosure as well as navigating to it.
    const revealHelp = () => {
        if (window.location.hash === '#how-to-race') {
            const help = document.querySelector<HTMLDetailsElement>('#how-to-race');
            if (help) help.open = true;
        }
    };
    document.addEventListener('astro:page-load', revealHelp);
    window.addEventListener('hashchange', revealHelp);
</script>
