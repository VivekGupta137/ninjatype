---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from "@/lib/schema-templates";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/fr/apprendre-a-taper-au-clavier/");
}

const fingerType = finger as FingerType;

const WITH_ARTICLE: Record<string, string> = { pointer: "l'index", middle: "le majeur", ring: "l'annulaire", pinky: "l'auriculaire" };
const fingerPhrase = WITH_ARTICLE[fingerType];
const canonicalURL = new URL(`/fr/apprendre-a-taper-au-clavier/${finger}/`, Astro.site || Astro.url.origin).href;
const pageTitle = `Dactylographie : leçons pour ${fingerPhrase} | NinjaType`;
const pageDescription = `Apprendre avec ${fingerPhrase} : leçons AZERTY 10 doigts français, position de base, prises supérieures et inférieures avec progrès.`;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: pageTitle, description: pageDescription, inLanguage: "fr" }),
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalURL}
    lang="fr"
    ogLocale="fr_FR"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "fr", href: canonicalURL },
    ]}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <div id="body-container">
        <Header locale="fr" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="fr" client:load />
            </div>
        </main>

        <Footer locale="fr" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
