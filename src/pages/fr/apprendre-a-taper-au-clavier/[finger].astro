---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import { FINGER_NAMES_FR } from "@/constants/fingerKeysFR";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/fr/apprendre-a-taper-au-clavier/");
}

const fingerType = finger as FingerType;

const canonicalURL = new URL(`/fr/apprendre-a-taper-au-clavier/${finger}/`, Astro.site || Astro.url.origin).href;
---

<BaseLayout
    title={`${FINGER_NAMES_FR[fingerType]} : leçons de dactylographie | NinjaType`}
    description={`Apprendre avec le ${FINGER_NAMES_FR[fingerType]} : leçons AZERTY 10 doigts français, position de base, prises supérieures et inférieures avec progrès.`}
    canonical={canonicalURL}
    lang="fr"
    ogLocale="fr_FR"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "fr", href: canonicalURL },
    ]}
>
    <div id="body-container">
        <Header locale="fr" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="fr" client:load />
            </div>
        </main>

        <Footer locale="fr" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
