---
import fs from 'node:fs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer';
import AdvertiseContent from '@/components/advertise/AdvertiseContent';
import '../styles/advertise.css';

const title = 'Advertise on NinjaType — Sponsorship for Publishers & Brands';
const description = 'Two simple, non-intrusive NinjaType sponsorships: a results-screen feature and a header and footer logo spot, in shared rotating spaces. Plus sponsored blog reviews.';
const canonical = new URL('/advertise/', Astro.site || Astro.url.origin).href;

/* Stats come from /public/info/stats.json (served at /info/stats.json). */
let stats = { last30daysVisitors: 0, last30daysPageViews: 0 };
try {
    stats = JSON.parse(fs.readFileSync(new URL('../../public/info/stats.json', import.meta.url), 'utf-8'));
} catch {}
---
<BaseLayout title={title} description={description} canonical={canonical} includeApplicationSchema={false}>
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="adv-page">
            <AdvertiseContent client:load stats={stats} />
        </main>
        <Footer />
    </div>
</BaseLayout>
