---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from "@/lib/schema-templates";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/it/dattilografia/");
}

const fingerType = finger as FingerType;

const WITH_ARTICLE: Record<string, string> = { pointer: "l'indice", middle: "il medio", ring: "l'anulare", pinky: "il mignolo" };
const fingerPhrase = WITH_ARTICLE[fingerType];
const canonicalURL = new URL(`/it/dattilografia/${finger}/`, Astro.site || Astro.url.origin).href;
const pageTitle = `Dattilografia QWERTY: lezioni per ${fingerPhrase} | NinjaType`;
const pageDescription = `Impara con ${fingerPhrase}: lezioni QWERTY per il metodo italiano — posizione di base, tasti superiori e inferiori, con progressi per livello.`;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: pageTitle, description: pageDescription, inLanguage: "it" }),
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalURL}
    lang="it"
    ogLocale="it_IT"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "it", href: canonicalURL },
    ]}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <div id="body-container">
        <Header locale="it" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="it" client:load />
            </div>
        </main>

        <Footer locale="it" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
