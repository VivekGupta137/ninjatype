---
import Footer from "@/components/Footer";
import Header from "@/components/Header.astro";
import { FaqList } from "@/components/ui/Faq";
import PracticeHelp from "@/components/seo/PracticeHelp.astro";
import OnlineKeyboardContainer from "@/components/online/OnlineKeyboardContainer";
import "../../styles/online.css";
import "../../styles/shadow-race.css";
import "../../styles/multiplayer.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrainingGuides from "@/components/blog/TrainingGuides.astro";
import {
    getWebApplicationSchema,
    getWebPageSchema,
    getFAQPageSchema,
    createSchemaGraph,
} from "@/lib/schema-templates";

const title = "Skrivetest-spil: Træn mod din egen rekord | NinjaType";
const description =
    "Skrivetest-spil med Ghost Race: skriv gratis mod din bedste gemte OPM-værdi — over 15, 30 eller 50 ord, med præcisions-tracking og nye dags-rekorder.";
const canonicalURL = new URL("/da/skrivetest-spil/", Astro.site).href;
const faqs = [
    {
        question: "Hvad er Ghost Race?",
        answer:
            "Ghost Race er et solo-skrivespil: din bedste gyldige gemte forsøg fra i dag bliver til en skygge, der projicerer sit gennemsnitlige tempo på en ny tekst. Du ser live, om du er foran eller bagud din skygge — uden live-modstandere.",
    },
    {
        question: "Hvornår nulstilles min dags-rekord?",
        answer:
            "Ved midnat i din lokale tid. Vælg „tidsbestwert“, hvis du vil skrive mod din livstidsrekord — den forbliver permanent gemt.",
    },
    {
        question: "Hvor lang er en Ghost Race-runde?",
        answer:
            "15, 30 eller 50 ord — du vælger længden før starten. Hvert ord skal være rigtigt, før mellemrumstasten fører videre.",
    },
    {
        question: "Har jeg brug for en konto?",
        answer:
            "Nej. Ghost Race kører helt i browseren, din bedste tempo gemmes lokalt. Heller ikke skrivehastighedstesten eller lektionerne har brug for en konto.",
    },
];
const schemaMarkup = createSchemaGraph(
    getWebPageSchema({ url: canonicalURL, name: title, description, inLanguage: "da" }),
    getWebApplicationSchema({ url: canonicalURL, name: title, description, features: ["Solo-løb mod dagens eller tidsbestwert", "15-, 30- eller 50-ords stræk", "Lokalt skrivehistorik"] }),
    getFAQPageSchema(faqs),
);
---

<BaseLayout
    title={title}
    description={description}
    canonical={canonicalURL}
    lang="da"
    ogLocale="da_DK"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: "https://www.ninjatype.com/ghost-race/" },
        { lang: "da", href: canonicalURL },
    ]}
>
    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schemaMarkup)}
    />

    <div id="body-container">
        <Header locale="da" />

        <main id="main-content" class="shadow-page">
            <OnlineKeyboardContainer client:load locale="da" />
            <PracticeHelp>
                <h3>Solo-skrivetest: Hyppige spørgsmål</h3>
                <FaqList client:visible faqs={faqs} />
            </PracticeHelp>
            <p class="multiplayer-guide-link da-shadow-links">
                Byg et grundlag med <a href="/da/skrivehastighedstest/">skrivehastighedstesten</a>, arbejd på svage taster i
                <a href="/da/maskinskrivning/">10-finger-lektionerne</a> — eller skriv mod venner i <a href="/da/skrivekonkurrence/">Multiplayer-skrivekonkurrencen</a>.
            </p>
            <TrainingGuides app="ghost-race" />
        </main>

        <Footer locale="da" />
    </div>
</BaseLayout>
<script>
    // The help link opens its disclosure as well as navigating to it.
    const revealHelp = () => {
        if (window.location.hash === '#how-to-race') {
            const help = document.querySelector<HTMLDetailsElement>('#how-to-race');
            if (help) help.open = true;
        }
    };
    document.addEventListener('astro:page-load', revealHelp);
    window.addEventListener('hashchange', revealHelp);
</script>
