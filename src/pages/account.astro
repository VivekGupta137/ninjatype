---
import Footer from "@/components/Footer";
import Header from "@/components/Header.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AccountPanel from "@/components/account/AccountPanel";
import "../styles/account.css";
import { Chip } from "@heroui/react";

const canonicalURL = new URL("/account/", Astro.site || Astro.url.origin).href;
---

<BaseLayout
    title="NinjaType Account - Sign In or Create an Account"
    description="Sign in to your NinjaType account or create one with an email and password. Your free typing practice does not require an account."
    canonical={canonicalURL}
    noindex
>
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="acct-page">
            <section class="acct-hero">
                <Chip size="sm" variant="soft">Optional · free typing stays free</Chip>
                <h1>Your NinjaType account</h1>
                <p class="acct-lede">Sign in to sync your practice across devices and manage Pro. Typing tests, lessons and races never need an account.</p>
            </section>
            <AccountPanel client:only="react" />
        </main>
        <Footer />
    </div>
</BaseLayout>
