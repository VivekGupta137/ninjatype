---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from "@/lib/schema-templates";
import FingerPractice from "@/components/learn/FingerPractice";
import type { FingerType } from "@/constants/fingerKeys";
import { FINGER_NAMES_SV } from "@/constants/fingerKeysSV";
import "../../../styles/learn.css";

export function getStaticPaths() {
    const fingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];
    return fingers.map(finger => ({
        params: { finger }
    }));
}

const { finger } = Astro.params;
const validFingers: FingerType[] = ["pointer", "middle", "ring", "pinky"];

// Validate finger parameter
if (!finger || !validFingers.includes(finger as FingerType)) {
    return Astro.redirect("/sv/tangentbordstraning/");
}

const fingerType = finger as FingerType;

const canonicalURL = new URL(`/sv/tangentbordstraning/${finger}/`, Astro.site || Astro.url.origin).href;
const pageTitle = `${FINGER_NAMES_SV[fingerType]}-träning: Svenska lektioner | NinjaType`;
const pageDescription = `Lär dig tangentbordsträning med ${FINGER_NAMES_SV[fingerType]}: QWERTY-lektioner för det svenska tio-fingersystemet — grundställning, övre och nedre grepp, med framsteg per nivå.`;
const schemaMarkup = createSchemaGraph(
    getOrganizationSchema(),
    getWebsiteSchema(),
    getWebPageSchema({ url: canonicalURL, name: pageTitle, description: pageDescription, inLanguage: "sv" }),
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalURL}
    lang="sv"
    ogLocale="sv_SE"
    includeApplicationSchema={false}
    alternates={[
        { lang: "en", href: `https://www.ninjatype.com/learn/fingers/${fingerType}/` },
        { lang: "sv", href: canonicalURL },
    ]}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <div id="body-container">
        <Header locale="sv" />

        <main id="main-content">
            <div id="finger-practice-main">
                <FingerPractice finger={fingerType} locale="sv" client:load />
            </div>
        </main>

        <Footer locale="sv" />
    </div>
</BaseLayout>

<style>
    #finger-practice-main {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
    }
</style>
