---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer';
import PageFAQ from '@/components/seo/PageFAQ.astro';
import { mainPageFAQs, learnPageFAQs, multiplayerPageFAQs, onlinePageFAQs } from '@/constants/faq';
import { createSchemaGraph, getOrganizationSchema, getWebsiteSchema, getWebPageSchema, getFAQPageSchema } from '@/lib/schema-templates';
const title = 'NinjaType Help — Typing Practice, Lessons & Race FAQs';
const description = 'Find answers about NinjaType typing tests, touch typing lessons, multiplayer rooms, and Ghost Race. Learn how settings, results, and saved progress work.';
const canonical = new URL('/help/', Astro.site || Astro.url.origin).href;
const sections = [
    { id: 'practice', name: 'Typing practice', href: '/', description: 'Tests, settings, WPM, and saved results.', faqs: mainPageFAQs },
    { id: 'learn', name: 'Touch typing lessons', href: '/learn/', description: 'Finger placement, exercises, and learning progress.', faqs: learnPageFAQs },
    { id: 'multiplayer', name: 'Multiplayer typing race', href: '/multiplayer-typing-race/', description: 'Rooms, invitations, race rules, and rematches.', faqs: multiplayerPageFAQs },
    { id: 'ghost-race', name: 'Ghost Race', href: '/ghost-race/', description: 'Your shadow, personal-best pace, and solo races.', faqs: onlinePageFAQs },
];
const schema = createSchemaGraph(getOrganizationSchema(), getWebsiteSchema(), getWebPageSchema({ url: canonical, name: title, description }), getFAQPageSchema(sections.flatMap(section => section.faqs)));
---
<BaseLayout title={title} description={description} canonical={canonical} includeApplicationSchema={false}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <div id="body-container">
        <Header informationPage />
        <main id="main-content" class="help-page">
            <div class="help-intro"><span class="help-eyebrow">A LITTLE GUIDANCE</span><h1>How can we help?</h1><p>Answers for your next practice session.</p></div>
            <nav class="help-topics" aria-label="Help topics">{sections.map(section => <a href={`#${section.id}`}>{section.name}</a>)}</nav>
            <div class="help-sections">
                {sections.map(section => <section id={section.id} aria-labelledby={`${section.id}-title`}>
                    <div class="help-section-heading"><div><h2 id={`${section.id}-title`}>{section.name}</h2><p>{section.description}</p></div><a href={section.href} aria-label={`Open ${section.name}`}>Open app <span aria-hidden="true">↗</span></a></div>
                    <PageFAQ title={`${section.name} FAQ`} faqs={section.faqs} />
                </section>)}
            </div>
            <p class="help-contact">Still need a hand? <a href="/contact/">Get in touch →</a></p>
        </main>
        <Footer />
    </div>
</BaseLayout>
<script>
    function revealHelpTopic() {
        const id = window.location.hash.slice(1);
        if (!id) return;
        const section = document.getElementById(id);
        if (section?.closest('.help-sections')) {
            const disclosure = section.querySelector('details');
            if (disclosure) disclosure.open = true;
        }
    }
    document.addEventListener('astro:page-load', revealHelpTopic);
    window.addEventListener('hashchange', revealHelpTopic);
</script>
<style>
    .help-page { width: 100%; max-width: 960px; margin: 1rem auto 3rem; }
    .help-intro { margin-bottom: 1.5rem; }
    .help-eyebrow { color: var(--sub-text-color); font-size: .7rem; letter-spacing: .12em; }
    h1 { color: var(--main-color); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; line-height: 1.2; margin: .5rem 0 .75rem; }
    p { color: var(--sub-text-color); font-size: .9rem; margin: 0; line-height: 1.7; }
    .help-topics { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
    .help-topics a { color: var(--text-color); background: var(--alt-bg-color); padding: .6rem .9rem; border: 1px solid var(--sub-alt-text-color); border-radius: .6rem; font-size: .8rem; }
    .help-topics a:hover { border-color: var(--main-color); }
    .help-sections { display: grid; gap: 1.25rem; }
    section { border: 1px solid var(--sub-alt-text-color); border-radius: .8rem; padding: 1.25rem; scroll-margin-top: 1rem; }
    .help-section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    h2 { color: var(--text-color); font-size: 1.15rem; font-weight: 600; margin: 0 0 .3rem; }
    .help-section-heading > a { flex-shrink: 0; color: var(--main-color); font-size: .8rem; padding: .3rem 0; }
    .help-contact { margin-top: 2rem; }
    .help-contact a { color: var(--main-color); }
    a:focus-visible { outline: 2px solid var(--main-color); outline-offset: 4px; }
    @media (max-width: 600px) { .help-section-heading { flex-direction: column; gap: .5rem; } section { padding: 1rem; } }
</style>
