---
import WPSLineChart from "../charts/WPSLineChart";
import Stats from "./Stats";
---

<div id="analytics-container">
    <div id="wps-line-chart-container">
        <div class="chart-header">
            <h2 class="chart-title">Performance</h2>
            <a
                href="/history/"
                class="performance-history-link"
                aria-label="View previous typing attempts and history analytics"
            >
                View previous attempts
                <span class="performance-history-arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div id="wps-line-chart">
            <WPSLineChart client:only />
        </div>
    </div>
    <Stats client:load />
</div>

<style>

    body[data-kb-typing-state="2"] #analytics-container {
        display: flex;
        margin-top: 0px;
    }
    #analytics-container {
        display: none;
        flex-direction: column;
        gap: 2.5rem;
        max-width: 100%;
        
    }
    #wps-line-chart-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    #wps-line-chart {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .chart-header {
        margin-bottom: 0.75rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
    }

    :global(.wps-chart-shell) {
        width: 100%;
    }

    .chart-title {
        color: var(--text-color);
        margin: 0;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: 0;
        font-family: "Bagel Fat One", system-ui;
    }

    .performance-history-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--sub-text-color);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        transition: color 0.15s ease;
    }

    .performance-history-link:hover,
    .performance-history-link:focus-visible {
        color: var(--main-color);
        outline: none;
    }

    .performance-history-arrow {
        transition: transform 0.15s ease;
    }

    .performance-history-link:hover .performance-history-arrow,
    .performance-history-link:focus-visible .performance-history-arrow {
        transform: translateX(2px);
    }

    :global(#analytics-container #stats-toolbar.session-stats) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.75rem;
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
        padding: 0.25rem 1rem 0;
        font-family: inherit;
        font-size: inherit;
        opacity: 1;
    }

    :global(#analytics-container .stats-primary) {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: clamp(2.5rem, 8vw, 5rem);
    }

    :global(#analytics-container .stats-secondary) {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        padding: 0.85rem 1.25rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--alt-bg-color) 88%, transparent);
        border: 1px solid color-mix(in srgb, var(--sub-alt-text-color) 45%, transparent);
    }

    :global(#analytics-container .session-stats .stat-item) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
    }

    :global(#analytics-container .stat-tooltip-trigger) {
        cursor: help;
        border-radius: 0.5rem;
        outline: none;
    }

    :global(#analytics-container .stat-tooltip-trigger:focus-visible) {
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--main-color) 55%, transparent);
    }

    :global(.stat-tooltip-content) {
        max-width: 220px;
    }

    :global(.stat-tooltip-title) {
        margin: 0 0 0.25rem;
        font-size: 0.8rem;
        font-weight: 650;
        color: var(--text-color);
    }

    :global(.stat-tooltip-desc) {
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--sub-text-color);
    }

    :global(#analytics-container .session-stats .stat-value) {
        font-size: 2.5rem;
        font-weight: 650;
        color: var(--text-color);
        font-variant-numeric: tabular-nums;
        line-height: 1;
        letter-spacing: -0.03em;
    }

    :global(#analytics-container .session-stats .stat-label) {
        font-size: 0.75rem;
        color: var(--sub-text-color);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }

    :global(#analytics-container .session-stats .stat-suffix) {
        font-size: 0.55em;
        font-weight: 600;
        margin-left: 0.08em;
        letter-spacing: 0;
        color: inherit;
        opacity: 0.85;
    }

    :global(#analytics-container .stat-item--hero .stat-value) {
        font-size: clamp(3rem, 8vw, 4.25rem);
        font-weight: 700;
        color: var(--main-color);
    }

    :global(#analytics-container .stat-item--hero .stat-label) {
        font-size: 0.8rem;
        letter-spacing: 0.18em;
    }

    :global(#analytics-container .stat-item--acc-high .stat-value) {
        color: var(--success-color);
    }

    :global(#analytics-container .stat-item--acc-mid .stat-value) {
        color: var(--main-color);
    }

    :global(#analytics-container .stat-item--acc-low .stat-value) {
        color: var(--error-color);
    }

    :global(#analytics-container .stat-item--meta .stat-value) {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--text-color);
        letter-spacing: -0.01em;
    }

    :global(#analytics-container .stat-item--meta .stat-label) {
        font-size: 0.65rem;
        letter-spacing: 0.12em;
    }

    :global(#analytics-container .stat-item--errors .stat-value),
    :global(#analytics-container .stat-item--errors .stat-label) {
        color: var(--error-color);
    }

    :global(#analytics-container .stat-dot) {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--sub-alt-text-color);
        opacity: 0.7;
        flex-shrink: 0;
    }

    :global(#analytics-container .stat-divider) {
        display: none;
    }

    @media (max-width: 768px) {
        #analytics-container {
            gap: 2rem;
        }

        .chart-title {
            font-size: 1.25rem;
        }

        :global(#analytics-container .stats-primary) {
            gap: 2.25rem;
        }

        :global(#analytics-container .stats-secondary) {
            gap: 0.6rem 1rem;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
        }
    }

    @media (max-width: 640px) {
        #analytics-container {
            gap: 1.5rem;
        }

        .chart-title {
            font-size: 1.125rem;
        }

        :global(#analytics-container #stats-toolbar.session-stats) {
            gap: 1.35rem;
        }

        :global(#analytics-container .stats-primary) {
            gap: 2rem;
            width: 100%;
            justify-content: space-evenly;
        }

        :global(#analytics-container .stat-item--hero .stat-value) {
            font-size: clamp(2.5rem, 12vw, 3.25rem);
        }

        :global(#analytics-container .stats-secondary) {
            width: 100%;
            justify-content: space-evenly;
            border-radius: 0.9rem;
        }
    }

    @media (max-width: 480px) {
        #analytics-container {
            gap: 1.25rem;
        }

        .chart-title {
            font-size: 1rem;
        }

        :global(#analytics-container .stat-item--meta .stat-value) {
            font-size: 1.05rem;
        }

        :global(#analytics-container .stat-dot) {
            display: none;
        }
    }

    @media (max-width: 360px) {
        :global(#analytics-container .stat-item--hero .stat-value) {
            font-size: 2.35rem;
        }

        :global(#analytics-container .stat-item--meta .stat-value) {
            font-size: 0.95rem;
        }

        :global(#analytics-container .stat-item--meta .stat-label) {
            font-size: 0.6rem;
        }
    }
</style>