---
import Navbar from "./common/Navbar";
import LiveUserCounter from "./LiveUserCounter";
import DailyStreak from "./DailyStreak";
import "../styles/daily-streak.css";

interface Props { informationPage?: boolean; }
const { informationPage = false } = Astro.props;
---

<header class="site-header">
    <div class="header-container">
        <div class="header-brand">
            <div id="logo">
                <a href="/" aria-label="NinjaType home">
                    <span id="logo-text" class="bagel-fat-one-regular">Ninja Type</span>
                </a>
                <p class="site-tagline">type faster, think clear</p>
            </div>
            <span class="header-brand-separator" aria-hidden="true">·</span>
            <div class="header-streak"><DailyStreak client:load /></div>
        </div>
        <Navbar pathname={Astro.url.pathname} section="utility" client:load />
    </div>
    <Navbar pathname={Astro.url.pathname} section="primary" client:load />
    {!informationPage && <div class="live-activity-indicator" style="position: fixed; bottom: 23px; left: 10px;">
        <LiveUserCounter client:load />
    </div>}
</header>
