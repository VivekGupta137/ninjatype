---
import "@/styles/static-pages.css";
interface Props {
    pageId: string;
    headings?: { depth: number; slug: string; text: string }[];
}
const { pageId, headings = [] } = Astro.props;
const pages = [
    { id: "about", label: "About", title: "A little practice. A lasting skill.", intro: "A calm space to build typing speed, find your rhythm, and make every keystroke count.", keys: "type" },
    { id: "contributors", label: "Contributors", title: "Built together, one key at a time.", intro: "NinjaType is open source. Code, design, documentation, and thoughtful feedback all help it grow.", keys: "join" },
    { id: "support", label: "Support", title: "Help keep practice open to everyone.", intro: "A small contribution goes a long way. Choose the way to support NinjaType that works for you.", keys: "help" },
    { id: "contact", label: "Contact", title: "Let’s make NinjaType better.", intro: "Found a bug, have an idea, or need a hand? Here’s the best place to start the conversation.", keys: "talk" },
    { id: "stars", label: "Star guide", title: "Every bit of progress counts.", intro: "Understand how speed and accuracy turn into stars in your finger practice lessons.", keys: "grow" },
    { id: "settings", label: "Settings", title: "Make room for your rhythm.", intro: "Choose your words, fine-tune your charts, and find a theme that feels like home.", keys: "tune" },
];
const page = pages.find((page) => page.id === pageId) ?? { label: "Page not found", title: "This page missed a keystroke.", intro: "The address may have changed, or the page may no longer exist. Your next practice session is still right here.", keys: "404" };
const sections = headings.filter((heading) => heading.depth === 2);
---
<div class="static-page">
    <div class="static-hero">
        <div>
            <p class="static-eyebrow">NINJATYPE / {page.label}</p>
            <h1>{page.title}</h1>
            <p class="static-intro">{page.intro}</p>
        </div>
        <div class="static-keyboard" aria-hidden="true">
            <div class="static-key-row">{page.keys.split("").map((key) => <span class="static-key">{key}</span>)}</div>
            <div class="static-key-row"><span class="static-key static-space"></span><span class="static-key static-enter">↵</span></div>
        </div>
    </div>
    <div class="static-layout">
        <aside class="static-sidebar">
            <nav aria-label="Explore NinjaType">
                <p class="static-nav-label">EXPLORE</p>
                {pages.map((item) => <a href={`/${item.id}/`} aria-current={pageId === item.id ? "page" : undefined}>{item.label}<span aria-hidden="true">↗</span></a>)}
            </nav>
            {sections.length > 0 && <nav class="static-section-nav" aria-label="On this page">
                <p class="static-nav-label">ON THIS PAGE</p>
                {sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
            </nav>}
            <a class="static-back" href="/">← Back to typing</a>
        </aside>
        <article class="static-content"><slot /></article>
    </div>
    <div class="static-outro">
        <div><span class="static-eyebrow">A LITTLE, EVERY DAY</span><p>Your next good habit starts with a keystroke.</p></div>
        <a class="static-button" href="/">Start typing <span aria-hidden="true">↵</span></a>
    </div>
</div>
