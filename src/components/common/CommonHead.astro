---
import "../../styles/fonts.css";
---

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- DNS Prefetch for performance optimization -->
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://scripts.simpleanalyticscdn.com" />

<!-- Preload the locally served logo font; other font faces load when used. -->
<link rel="preload" href="/fonts/bagel-fat-one-latin-400.woff2" as="font" type="font/woff2" crossorigin />

<!-- RSS Feed -->
<link
    rel="alternate"
    type="application/rss+xml"
    title="NinjaType RSS Feed"
    href="/rss.xml"
/>


<!-- Theme -->
<link rel="stylesheet" as="style" id="currentTheme" href="/themes/amoled.css" />

<script>
    import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
    import { $config } from "@/store/config";
    import { THEME } from "@/constants/themes";

    function applyTheme(target: Document = document) {
        const href = THEME[$config.get().theme]?.path ?? THEME.amoled.path;
        const stylesheet = target.querySelector("#currentTheme");
        if (stylesheet?.getAttribute("href") !== href) {
            stylesheet?.setAttribute("href", href);
        }
    }

    $config.subscribe(() => applyTheme());

    // Shared scripts run once, while client navigation replaces the page head.
    // Set the incoming theme before swapping to preserve the selected colors.
    document.addEventListener("astro:before-swap", (event) => {
        applyTheme((event as TransitionBeforeSwapEvent).newDocument);
    });
    document.addEventListener("astro:after-swap", () => applyTheme());
</script>
