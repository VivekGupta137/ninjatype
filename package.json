        "version:sync": "bun scripts/readme-sync-version.js",
        "build": "astro build",
        "check:seo": "node scripts/check-seo.mjs",
        "preview": "astro preview",
        "astro": "astro",
        "deploy": "wrangler pages deploy ",
        "lighthouse": "lhci autorun",
